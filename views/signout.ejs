<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Signing out - LabelIQ</title>
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
</head>
<body>
  <p>Signing out...</p>
  <script>
    const supabaseUrl = <%- JSON.stringify(supabase.url || '') %>;
    const supabasePublishableKey = <%- JSON.stringify(supabase.publishableKey || '') %>;
    const redirectTo = <%- JSON.stringify(redirectTo || '/') %>;

    async function finishSignout() {
      try {
        if (supabaseUrl && supabasePublishableKey && window.supabase) {
          const client = supabase.createClient(supabaseUrl, supabasePublishableKey);
          await client.auth.signOut();
        }
      } catch (error) {
        console.warn(error);
      } finally {
        window.location.href = redirectTo;
      }
    }

    finishSignout();
  </script>
</body>
</html>
