<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>LabelIQ - Business Portal</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['Inter', 'sans-serif'] },
          colors: {
            brand: {
              DEFAULT: '#4638d9',
              hover: '#3a2ec2'
            }
          }
        }
      }
    }
  </script>
</head>
<body class="bg-[#fcfdff] text-slate-700 antialiased font-sans min-h-screen flex flex-col overflow-x-hidden">

  <!-- Top Navbar -->
  <header class="w-full bg-white border-b border-slate-100 sticky top-0 z-50">
    <div class="px-4 sm:px-6 lg:px-8 min-h-16 py-3 flex flex-wrap items-center justify-between gap-3">
      
      <!-- Brand & Links -->
      <div class="flex min-w-0 items-center gap-3 lg:gap-10">
        <button
          id="business-menu-open"
          type="button"
          class="inline-flex h-11 w-11 items-center justify-center rounded-xl border border-slate-200 text-slate-700 hover:bg-slate-50 lg:hidden"
          aria-label="Open menu"
          aria-controls="business-sidebar"
        >
          <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <line x1="4" y1="6" x2="20" y2="6"></line>
            <line x1="4" y1="12" x2="20" y2="12"></line>
            <line x1="4" y1="18" x2="20" y2="18"></line>
          </svg>
        </button>
        <a href="/" class="flex items-center">
          <%- include('partials/brand-logo') %>
        </a>

        <nav class="hidden md:flex items-center gap-8 text-[14px] font-medium text-slate-600">
          <a href="#" class="hover:text-slate-900 transition-colors" data-i18n="nav.product">Product</a>
          <a href="#" class="hover:text-slate-900 transition-colors" data-i18n="nav.ruleEngine">Rule Engine</a>
          <a href="#" class="hover:text-slate-900 transition-colors" data-i18n="nav.verification">Verification</a>
        </nav>
      </div>

      <!-- Right Profile Menu with Functional Dropdown -->
      <div class="flex min-w-0 flex-1 items-center justify-end gap-2 sm:gap-4 lg:gap-6">
        <%- include('partials/language-selector') %>
        <div class="relative hidden min-w-0 sm:block" id="portal-menu-container">
          <button 
            id="portal-btn"
            type="button"
            class="flex min-w-0 items-center gap-1.5 text-[14px] font-medium text-slate-800 hover:text-slate-900 focus:outline-none"
          >
            <span class="truncate sm:whitespace-nowrap">Business Portal</span>
            <svg id="dropdown-chevron" class="w-4 h-4 text-slate-400 stroke-[2] transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </button>

          <div 
            id="portal-dropdown" 
            class="hidden absolute right-0 top-full mt-2 w-56 bg-white rounded-2xl shadow-xl shadow-slate-200/60 border border-slate-100 overflow-hidden z-50 py-1"
          >
            <a href="/public" class="w-full px-5 py-3 text-left text-[14px] font-medium text-slate-800 hover:bg-slate-50 transition-colors block">
              Consumer Portal
            </a>
            <a href="/business" class="w-full px-5 py-3 text-left text-[14px] font-medium text-[#4638d9] bg-[#f5f6ff] hover:bg-[#eceeff] flex items-center justify-between transition-colors block">
              <span>Business Portal</span>
              <svg class="w-3.5 h-3.5 text-[#4638d9] stroke-[2.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </a>
            <a href="/legal" class="w-full px-5 py-3 text-left text-[14px] font-medium text-slate-800 hover:bg-slate-50 transition-colors block">
              Legal Authority
            </a>
          </div>
        </div>

        <a href="/signout?portal=business" class="shrink-0 px-3 sm:px-5 py-2 rounded-lg bg-[#4638d9] hover:bg-[#3a2ec2] text-white font-medium text-[14px] shadow-sm transition-colors whitespace-nowrap" data-i18n="action.signOut">
          Sign Out
        </a>
      </div>
    </div>
  </header>

  <div class="flex flex-1 min-w-0">
    <div id="business-sidebar-backdrop" class="hidden fixed inset-0 z-[55] bg-slate-950/45 lg:hidden"></div>
    
    <!-- Sidebar -->
    <aside
      id="business-sidebar"
      class="fixed inset-y-0 left-0 z-[60] w-80 max-w-[calc(100vw-2rem)] -translate-x-full overflow-y-auto border-r border-slate-100 bg-white flex flex-col justify-between py-5 lg:py-6 px-4 shrink-0 shadow-2xl shadow-slate-900/20 transition-transform duration-200 ease-out lg:static lg:z-auto lg:w-64 lg:max-w-none lg:translate-x-0 lg:shadow-none"
      aria-label="Business navigation"
    >
      <div class="space-y-6">
        <div class="flex items-center justify-between gap-3 lg:hidden">
          <span class="text-sm font-bold text-slate-900">Business Menu</span>
          <button
            id="business-menu-close"
            type="button"
            class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-slate-200 text-slate-700 hover:bg-slate-50"
            aria-label="Close menu"
          >
            <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>
        
        <!-- Company Header -->
        <div class="flex items-center justify-between gap-3 px-3 py-1">
          <div class="min-w-0" data-sidebar-label>
            <h2 class="text-sm font-bold text-slate-900 leading-tight truncate"><%= data.company.name %></h2>
            <p class="text-xs text-slate-400 mt-0.5 truncate"><%= data.company.role %></p>
          </div>
          <button id="business-sidebar-collapse" type="button" class="hidden lg:inline-flex h-9 w-9 items-center justify-center rounded-lg text-slate-400 hover:bg-slate-50 hover:text-slate-600" aria-label="Collapse sidebar" aria-expanded="true">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
            </svg>
          </button>
        </div>

        <!-- Navigation Links -->
        <nav class="grid grid-cols-1 sm:grid-cols-2 lg:block lg:space-y-1 gap-2 lg:gap-0">
          <!-- Active Tab: Overview -->
          <a href="#overview" data-business-nav="Overview" class="business-nav-link flex min-w-0 items-center gap-3 px-3 py-2.5 rounded-xl bg-[#f5f6ff] text-[#4638d9] font-semibold text-[14px]">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <rect x="3" y="3" width="7" height="7" rx="1"></rect>
              <rect x="14" y="3" width="7" height="7" rx="1"></rect>
              <rect x="14" y="14" width="7" height="7" rx="1"></rect>
              <rect x="3" y="14" width="7" height="7" rx="1"></rect>
            </svg>
            <span class="truncate" data-sidebar-label>Overview</span>
          </a>

          <a href="#product-catalog" data-business-nav="Product Catalog" class="business-nav-link flex min-w-0 items-center gap-3 px-3 py-2.5 rounded-xl text-slate-600 hover:bg-slate-50 font-medium text-[14px] transition-colors">
            <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <rect x="3" y="4" width="18" height="16" rx="2"></rect>
              <line x1="7" y1="8" x2="17" y2="8"></line>
              <line x1="7" y1="12" x2="13" y2="12"></line>
            </svg>
            <span class="truncate" data-sidebar-label>Product Catalog</span>
          </a>

          <a href="#artwork-precheck" data-open-business-scan data-mode="Artwork Pre-Check" class="business-nav-link flex min-w-0 items-center gap-3 px-3 py-2.5 rounded-xl text-slate-600 hover:bg-slate-50 font-medium text-[14px] transition-colors">
            <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
            <span class="truncate" data-sidebar-label>Artwork Pre-Check</span>
          </a>

          <a href="#scan-commodity" data-open-business-scan data-mode="Scan Commodity" class="business-nav-link flex min-w-0 items-center gap-3 px-3 py-2.5 rounded-xl text-slate-600 hover:bg-slate-50 font-medium text-[14px] transition-colors">
            <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M4 7V5a1 1 0 0 1 1-1h2"></path>
              <path d="M17 4h2a1 1 0 0 1 1 1v2"></path>
              <path d="M20 17v2a1 1 0 0 1-1 1h-2"></path>
              <path d="M7 20H5a1 1 0 0 1-1-1v-2"></path>
              <rect x="8" y="8" width="8" height="8" rx="2"></rect>
            </svg>
            <span class="truncate" data-sidebar-label>Scan Commodity</span>
          </a>

          <a href="#batch-audits" data-business-notice="Batch audit history is shown in the product table. Use search or export to review the current audit set." class="business-nav-link flex min-w-0 items-center gap-3 px-3 py-2.5 rounded-xl text-slate-600 hover:bg-slate-50 font-medium text-[14px] transition-colors">
            <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <line x1="4" y1="6" x2="20" y2="6"></line>
              <line x1="4" y1="12" x2="20" y2="12"></line>
              <line x1="4" y1="18" x2="20" y2="18"></line>
            </svg>
            <span class="truncate" data-sidebar-label>Batch Audits</span>
          </a>

          <a href="#correction-history" data-business-notice="Correction history is audit-ready. Open a scanned inspection result to accept, edit, reject, or add remarks to extracted fields." class="business-nav-link flex min-w-0 items-center gap-3 px-3 py-2.5 rounded-xl text-slate-600 hover:bg-slate-50 font-medium text-[14px] transition-colors">
            <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            <span class="truncate" data-sidebar-label>Correction History</span>
          </a>

          <a href="#settings" data-business-notice="Business settings are connected to the signed-in portal session and company profile." class="business-nav-link flex min-w-0 items-center gap-3 px-3 py-2.5 rounded-xl text-slate-600 hover:bg-slate-50 font-medium text-[14px] transition-colors">
            <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="3"></circle>
              <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
            </svg>
            <span class="truncate" data-sidebar-label>Settings</span>
          </a>
        </nav>
      </div>

      <!-- Verification Footer -->
      <div class="px-3 pt-6 border-t border-slate-100 text-xs text-slate-400 space-y-1" data-sidebar-label>
        <p class="break-words">GSTIN: <%= data.company.gstin %></p>
        <p class="flex items-center gap-1 text-slate-500 font-medium">
          Verified Manufacturer
          <span class="text-slate-600">✓</span>
        </p>
      </div>
    </aside>

    <!-- Main Content Area -->
    <main class="w-full min-w-0 flex-1 px-4 sm:px-6 lg:px-10 py-6 lg:py-8 overflow-y-auto">
      
      <!-- Top Title + Action Button -->
      <div class="flex flex-col xl:flex-row xl:items-start xl:justify-between gap-4">
        <div class="min-w-0">
          <h1 class="text-2xl font-bold text-slate-900 tracking-tight break-words">Product Compliance</h1>
          <p class="text-sm text-slate-500 mt-1 break-words">Batch audit dashboard — <%= data.company.name %> Pvt. Ltd.</p>
        </div>

        <div class="flex flex-col sm:flex-row sm:flex-wrap sm:items-center xl:justify-end gap-3">
          <button data-open-business-scan data-mode="Scan Label" class="flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl bg-[#4638d9] hover:bg-[#3a2ec2] text-white font-semibold text-sm shadow-sm transition-colors">
            <svg class="w-4 h-4 stroke-[2.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path d="M4 7V5a1 1 0 0 1 1-1h2"></path>
              <path d="M17 4h2a1 1 0 0 1 1 1v2"></path>
              <path d="M20 17v2a1 1 0 0 1-1 1h-2"></path>
              <path d="M7 20H5a1 1 0 0 1-1-1v-2"></path>
              <rect x="8" y="8" width="8" height="8" rx="2"></rect>
            </svg>
            Scan Label
          </button>
          <button data-open-business-scan data-mode="Artwork Pre-Check" class="flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl bg-[#4638d9] hover:bg-[#3a2ec2] text-white font-semibold text-sm shadow-sm transition-colors">
            <svg class="w-4 h-4 stroke-[2.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            Artwork Pre-Check
          </button>
        </div>
      </div>

      <div id="business-notice" class="hidden mt-5 rounded-2xl border border-indigo-100 bg-indigo-50/60 px-4 py-3 text-sm text-[#4338CA] font-medium"></div>

      <!-- 4 Stats Cards Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mt-8">
        
        <div class="bg-white border border-slate-200/70 rounded-2xl p-6 shadow-xs">
          <p class="text-3xl font-bold text-slate-900"><%= data.metrics.scannedCount %></p>
          <p class="text-sm font-semibold text-slate-800 mt-2">Products scanned</p>
          <p class="text-xs text-slate-400 mt-0.5"><%= data.metrics.scannedPeriod %></p>
        </div>

        <div class="bg-white border border-slate-200/70 rounded-2xl p-6 shadow-xs">
          <p class="text-3xl font-bold text-[#059669]"><%= data.metrics.compliantRate %></p>
          <p class="text-sm font-semibold text-slate-800 mt-2">Compliant rate</p>
          <p class="text-xs text-slate-400 mt-0.5"><%= data.metrics.compliantSubtitle %></p>
        </div>

        <div class="bg-white border border-slate-200/70 rounded-2xl p-6 shadow-xs">
          <p class="text-3xl font-bold text-slate-900"><%= data.metrics.pendingReview %></p>
          <p class="text-sm font-semibold text-slate-800 mt-2">Pending review</p>
          <p class="text-xs text-slate-400 mt-0.5"><%= data.metrics.pendingSubtitle %></p>
        </div>

        <div class="bg-white border border-slate-200/70 rounded-2xl p-6 shadow-xs">
          <p class="text-3xl font-bold text-[#dc2626]"><%= data.metrics.violationsCount %></p>
          <p class="text-sm font-semibold text-slate-800 mt-2">Active violations</p>
          <p class="text-xs text-slate-400 mt-0.5"><%= data.metrics.violationsSubtitle %></p>
        </div>
      </div>

      <!-- Table Container -->
      <div id="product-catalog" class="mt-8 bg-white border border-slate-200/80 rounded-2xl overflow-hidden shadow-xs">
        
        <!-- Search & Export Bar -->
        <div class="p-5 flex flex-wrap items-center justify-between gap-4">
          <div class="relative w-full sm:w-96">
            <svg class="w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input 
              id="business-product-search"
              type="text" 
              placeholder="Search products..." 
              class="w-full pl-10 pr-8 py-2 border border-slate-200 rounded-lg text-sm placeholder-slate-400 focus:outline-none focus:border-indigo-400"
            />
            <span class="absolute right-3 top-1/2 -translate-y-1/2 text-xs text-slate-400 font-mono">/</span>
          </div>

          <div class="flex flex-wrap items-center gap-4">
            <span id="business-product-count" class="text-xs text-slate-400 font-medium"><%= data.products.length %> products</span>
            <button id="business-export-csv" class="px-4 py-2 border border-slate-200 rounded-lg text-xs font-semibold text-slate-700 hover:bg-slate-50 transition-colors shadow-xs">
              Export CSV
            </button>
          </div>
        </div>

        <!-- Products Table -->
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs border-collapse">
            <thead>
              <tr class="border-y border-slate-100 bg-[#f9fafb]/50 text-slate-400 font-bold uppercase tracking-wider">
                <th class="py-3 px-6">PRODUCT</th>
                <th class="py-3 px-6">SKU</th>
                <th class="py-3 px-6">TYPE</th>
                <th class="py-3 px-6">DESTINATION</th>
                <th class="py-3 px-6">LAST CHECKED</th>
                <th class="py-3 px-6">STATUS</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% data.products.forEach(item => { %>
                <tr class="business-product-row hover:bg-slate-50/70 transition-colors cursor-pointer" data-search="<%= [item.name, item.category, item.sku, item.type, item.destination, item.status].join(' ').toLowerCase() %>" data-product="<%= item.name %>" data-sku="<%= item.sku %>" data-status="<%= item.status %>">
                  <td class="py-4 px-6">
                    <p class="font-bold text-slate-800 text-[13px]"><%= item.name %></p>
                    <p class="text-slate-400 mt-0.5"><%= item.category %></p>
                  </td>

                  <td class="py-4 px-6 font-mono text-slate-500 text-[11px]"><%= item.sku %></td>

                  <td class="py-4 px-6">
                    <% if (item.type === 'Retail') { %>
                      <span class="px-2.5 py-0.5 rounded-full bg-[#eef2ff] text-[#4338ca] text-[11px] font-medium">Retail</span>
                    <% } else { %>
                      <span class="px-2.5 py-0.5 rounded-full bg-[#ecfdf5] text-[#059669] text-[11px] font-medium">Bulk</span>
                    <% } %>
                  </td>

                  <td class="py-4 px-6 text-slate-500 text-[12px]"><%= item.destination %></td>

                  <td class="py-4 px-6 text-slate-500 text-[12px]"><%= item.lastChecked %></td>

                  <td class="py-4 px-6">
                    <div class="flex items-center gap-2">
                      <% if (item.status === 'Compliant') { %>
                        <span class="px-3 py-1 rounded-full bg-[#ecfdf5] text-[#059669] text-[11px] font-semibold">Compliant</span>
                      <% } else if (item.status === 'Non-Compliant') { %>
                        <span class="px-3 py-1 rounded-full bg-[#fef2f2] text-[#dc2626] text-[11px] font-semibold">Non-Compliant</span>
                        <% if (item.flagCount) { %>
                          <span class="text-[11px] font-semibold text-[#dc2626]"><%= item.flagCount %></span>
                        <% } %>
                      <% } else if (item.status === 'Needs Review') { %>
                        <span class="px-3 py-1 rounded-full bg-[#fffbeb] text-[#d97706] text-[11px] font-semibold">Needs Review</span>
                        <% if (item.flagCount) { %>
                          <span class="text-[11px] font-semibold text-[#d97706]"><%= item.flagCount %></span>
                        <% } %>
                      <% } else { %>
                        <span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-[11px] font-semibold">Pending</span>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        <!-- Pagination -->
        <div class="p-4 border-t border-slate-100 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 text-xs text-slate-500">
          <span>Page 1 of 1</span>
          <div class="flex items-center gap-2">
            <button class="px-2.5 py-1 text-slate-400 hover:text-slate-600">&lt; Prev</button>
            <button class="w-6 h-6 rounded bg-[#4638d9] text-white font-semibold flex items-center justify-center">1</button>
            <button class="px-2.5 py-1 text-slate-400 hover:text-slate-600">Next &gt;</button>
          </div>
        </div>

      </div>

    </main>
  </div>

  <div id="business-scan-modal" class="hidden fixed inset-0 z-[60] bg-slate-900/45 backdrop-blur-sm px-4 py-8 overflow-y-auto">
    <div class="mx-auto mt-12 w-full max-w-xl rounded-3xl bg-white shadow-2xl shadow-slate-900/20">
      <div class="p-8">
        <div class="flex items-start justify-between gap-4">
          <div>
            <h2 id="business-scan-title" class="text-xl font-bold text-slate-900">Scan Packaging Label</h2>
            <p id="business-scan-subtitle" class="mt-1 text-sm text-slate-400">Upload package photos for OCR, declarations, rules, and evidence.</p>
          </div>
          <button id="business-scan-close" type="button" class="text-slate-400 hover:text-slate-700">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>

        <label id="business-dropzone" class="mt-7 block cursor-pointer rounded-2xl border-2 border-dashed border-indigo-200 bg-[#f8faff] px-6 py-10 text-center hover:border-[#4638d9] transition-colors">
          <input id="business-scan-files" type="file" accept="image/*" multiple class="hidden" />
          <span class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-[#eef2ff] text-[#4638d9]">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M4 7V5a1 1 0 0 1 1-1h2"></path>
              <path d="M17 4h2a1 1 0 0 1 1 1v2"></path>
              <path d="M20 17v2a1 1 0 0 1-1 1h-2"></path>
              <path d="M7 20H5a1 1 0 0 1-1-1v-2"></path>
              <circle cx="12" cy="12" r="3"></circle>
            </svg>
          </span>
          <span id="business-file-summary" class="mt-4 block text-sm font-semibold text-slate-800">Click to upload front/back package photos</span>
          <span class="mt-1 block text-xs text-slate-400">Supports JPG, PNG, and WEBP images up to 25MB per file</span>
        </label>

        <div class="mt-6">
          <label for="business-category" class="text-xs font-bold uppercase tracking-wider text-slate-500">Commodity type / category</label>
          <select id="business-category" class="mt-2 w-full rounded-xl border border-slate-200 px-4 py-3 text-sm text-slate-700 focus:outline-none focus:border-[#4638d9]">
            <option>Food & Beverages</option>
            <option>Cosmetics</option>
            <option>Medical</option>
            <option>Household</option>
            <option>Textiles</option>
          </select>
        </div>

        <div id="business-scan-status" class="hidden mt-5 rounded-xl border border-indigo-100 bg-indigo-50/60 px-4 py-3 text-sm text-[#4338CA] font-medium"></div>

        <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-3">
          <button id="business-scan-cancel" type="button" class="rounded-xl border border-slate-200 px-4 py-3 text-sm font-semibold text-slate-700 hover:bg-slate-50">Cancel</button>
          <button id="business-scan-submit" type="button" class="rounded-xl bg-[#4638d9] px-4 py-3 text-sm font-semibold text-white hover:bg-[#3a2ec2] disabled:opacity-50" disabled>
            Run Compliance Scan
          </button>
        </div>
      </div>
    </div>
  </div>

  <%- include('partials/assistant-widget') %>

  <script src="/js/i18n.js"></script>
  <script>
    const businessProducts = <%- JSON.stringify(data.products).replace(/</g, '\\u003c') %>;
    const portalBtn = document.getElementById('portal-btn');
    const portalDropdown = document.getElementById('portal-dropdown');
    const dropdownChevron = document.getElementById('dropdown-chevron');
    const businessMenuOpen = document.getElementById('business-menu-open');
    const businessMenuClose = document.getElementById('business-menu-close');
    const businessSidebar = document.getElementById('business-sidebar');
    const businessSidebarBackdrop = document.getElementById('business-sidebar-backdrop');
    const businessSidebarCollapse = document.getElementById('business-sidebar-collapse');
    const productSearch = document.getElementById('business-product-search');
    const productCount = document.getElementById('business-product-count');
    const productRows = Array.from(document.querySelectorAll('.business-product-row'));
    const exportCsvButton = document.getElementById('business-export-csv');
    const businessNotice = document.getElementById('business-notice');
    const scanModal = document.getElementById('business-scan-modal');
    const scanTitle = document.getElementById('business-scan-title');
    const scanSubtitle = document.getElementById('business-scan-subtitle');
    const scanFileInput = document.getElementById('business-scan-files');
    const scanFileSummary = document.getElementById('business-file-summary');
    const scanStatus = document.getElementById('business-scan-status');
    const scanSubmit = document.getElementById('business-scan-submit');
    const scanClose = document.getElementById('business-scan-close');
    const scanCancel = document.getElementById('business-scan-cancel');
    const scanFiles = [];
    let businessDrawerHistoryPushed = false;

    function openBusinessMenu(pushHistory = true) {
      businessSidebar.classList.remove('-translate-x-full');
      businessSidebarBackdrop.classList.remove('hidden');
      document.body.classList.add('overflow-hidden', 'lg:overflow-auto');
      if (pushHistory && window.innerWidth < 1024 && !businessDrawerHistoryPushed) {
        history.pushState({ businessMenuOpen: true }, '');
        businessDrawerHistoryPushed = true;
      }
    }

    function closeBusinessMenu(fromPopState = false) {
      businessSidebar.classList.add('-translate-x-full');
      businessSidebarBackdrop.classList.add('hidden');
      document.body.classList.remove('overflow-hidden', 'lg:overflow-auto');
      if (!fromPopState && businessDrawerHistoryPushed && window.innerWidth < 1024) {
        businessDrawerHistoryPushed = false;
        history.back();
        return;
      }
      businessDrawerHistoryPushed = false;
    }

    businessMenuOpen?.addEventListener('click', () => openBusinessMenu());
    businessMenuClose?.addEventListener('click', () => closeBusinessMenu());
    businessSidebarBackdrop?.addEventListener('click', () => closeBusinessMenu());
    businessSidebar?.querySelectorAll('a, button[data-open-business-scan], a[data-business-notice]').forEach((item) => {
      item.addEventListener('click', () => {
        if (window.innerWidth < 1024) closeBusinessMenu(true);
      });
    });
    window.addEventListener('popstate', () => {
      if (businessDrawerHistoryPushed) closeBusinessMenu(true);
    });
    window.addEventListener('resize', () => {
      if (window.innerWidth >= 1024) closeBusinessMenu(true);
    });

    businessSidebarCollapse?.addEventListener('click', () => {
      const collapsed = businessSidebar.classList.toggle('lg:w-20');
      businessSidebar.classList.toggle('lg:w-64', !collapsed);
      businessSidebarCollapse.setAttribute('aria-expanded', String(!collapsed));
      businessSidebar.querySelectorAll('[data-sidebar-label]').forEach((item) => item.classList.toggle('lg:hidden', collapsed));
      businessSidebar.querySelectorAll('.business-nav-link').forEach((item) => item.classList.toggle('lg:justify-center', collapsed));
    });

    function showBusinessNotice(message) {
      businessNotice.textContent = message;
      businessNotice.classList.remove('hidden');
      businessNotice.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    function setActiveBusinessNav(link) {
      document.querySelectorAll('.business-nav-link').forEach((item) => {
        item.classList.remove('bg-[#f5f6ff]', 'text-[#4638d9]', 'font-semibold');
        item.classList.add('text-slate-600', 'font-medium');
      });
      if (!link) return;
      link.classList.add('bg-[#f5f6ff]', 'text-[#4638d9]', 'font-semibold');
      link.classList.remove('text-slate-600', 'font-medium');
    }

    function openBusinessScan(mode = 'Scan Label') {
      scanTitle.textContent = mode === 'Artwork Pre-Check' ? 'Artwork Pre-Check' : 'Scan Packaging Label';
      scanSubtitle.textContent = mode === 'Artwork Pre-Check'
        ? 'Upload artwork or label images to screen mandatory declarations before packaging release.'
        : 'Enterprise package scan - OCR, declarations, rules, and evidence.';
      scanStatus.classList.add('hidden');
      scanStatus.textContent = '';
      scanModal.classList.remove('hidden');
    }

    function closeBusinessScan() {
      scanModal.classList.add('hidden');
    }

    function refreshScanFiles() {
      scanSubmit.disabled = scanFiles.length === 0;
      if (!scanFiles.length) {
        scanFileSummary.textContent = 'Click to upload front/back package photos';
        return;
      }
      scanFileSummary.textContent = `${scanFiles.length} selected: ${scanFiles.map((file) => file.name).join(', ')}`;
    }

    async function readApiPayload(response) {
      const text = await response.text();
      if (!text) return {};
      try {
        return JSON.parse(text);
      } catch (error) {
        return { error: text };
      }
    }

    function renderBusinessJob(job) {
      scanStatus.classList.remove('hidden');
      scanStatus.innerHTML = `
        <div class="flex items-center justify-between gap-3">
          <span>${job.message || 'Processing package images...'}</span>
          <span>${job.progress || 0}%</span>
        </div>
        ${job.error ? `<p class="mt-2 text-xs font-semibold text-red-600">${job.error}</p>` : ''}
      `;
    }

    async function pollBusinessJob(jobId) {
      const response = await fetch(`/api/analysis/jobs/${jobId}`);
      const job = await readApiPayload(response);
      if (!response.ok) throw new Error(job.error || 'Could not read analysis job.');
      renderBusinessJob(job);
      if (job.status === 'COMPLETED') {
        window.location.href = job.result_url;
        return;
      }
      if (job.status === 'FAILED' || job.status === 'CANCELLED') {
        scanSubmit.disabled = false;
        return;
      }
      setTimeout(() => pollBusinessJob(jobId), 1500);
    }

    document.querySelectorAll('[data-open-business-scan]').forEach((button) => {
      button.addEventListener('click', (event) => {
        event.preventDefault();
        setActiveBusinessNav(event.currentTarget.closest('.business-nav-link'));
        openBusinessScan(event.currentTarget.dataset.mode || 'Scan Label');
      });
    });

    document.querySelectorAll('[data-business-notice]').forEach((link) => {
      link.addEventListener('click', (event) => {
        event.preventDefault();
        setActiveBusinessNav(event.currentTarget);
        showBusinessNotice(event.currentTarget.dataset.businessNotice);
      });
    });

    document.querySelector('[data-business-nav="Product Catalog"]')?.addEventListener('click', (event) => {
      event.preventDefault();
      setActiveBusinessNav(event.currentTarget);
      document.getElementById('product-catalog')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      productSearch?.focus();
    });

    scanFileInput.addEventListener('change', (event) => {
      scanFiles.splice(0, scanFiles.length, ...Array.from(event.target.files).filter((file) => file.type.startsWith('image/')).slice(0, 6));
      refreshScanFiles();
    });

    scanClose.addEventListener('click', closeBusinessScan);
    scanCancel.addEventListener('click', closeBusinessScan);
    scanModal.addEventListener('click', (event) => {
      if (event.target === scanModal) closeBusinessScan();
    });

    scanSubmit.addEventListener('click', async () => {
      if (!scanFiles.length) return;
      scanSubmit.disabled = true;
      scanStatus.classList.remove('hidden');
      scanStatus.textContent = 'Uploading package images...';
      try {
        const formData = new FormData();
        scanFiles.forEach((file) => {
          formData.append('photos', file);
          formData.append('imageTypes', 'business-label');
        });
        formData.append('category', document.getElementById('business-category').value);
        const response = await fetch('/api/analysis/jobs', { method: 'POST', body: formData });
        const payload = await readApiPayload(response);
        if (!response.ok) throw new Error(payload.error || 'Could not start scan.');
        pollBusinessJob(payload.job_id);
      } catch (error) {
        scanStatus.textContent = error.message;
        scanSubmit.disabled = false;
      }
    });

    productSearch.addEventListener('input', () => {
      const query = productSearch.value.trim().toLowerCase();
      let visibleCount = 0;
      productRows.forEach((row) => {
        const match = row.dataset.search.includes(query);
        row.classList.toggle('hidden', !match);
        if (match) visibleCount += 1;
      });
      productCount.textContent = `${visibleCount} product${visibleCount === 1 ? '' : 's'}`;
    });

    productRows.forEach((row) => {
      row.addEventListener('click', () => {
        showBusinessNotice(`${row.dataset.product} (${row.dataset.sku}) is currently marked ${row.dataset.status}. Run a fresh scan to generate OCR evidence and a rule-based inspection result.`);
      });
    });

    exportCsvButton.addEventListener('click', () => {
      const headers = ['Product', 'Category', 'SKU', 'Type', 'Destination', 'Last Checked', 'Status', 'Flags'];
      const rows = businessProducts.map((item) => [
        item.name,
        item.category,
        item.sku,
        item.type,
        item.destination,
        item.lastChecked,
        item.status,
        item.flagCount || ''
      ]);
      const csv = [headers, ...rows]
        .map((row) => row.map((cell) => `"${String(cell).replaceAll('"', '""')}"`).join(','))
        .join('\n');
      const url = URL.createObjectURL(new Blob([csv], { type: 'text/csv;charset=utf-8;' }));
      const link = document.createElement('a');
      link.href = url;
      link.download = 'labeliq-business-products.csv';
      link.click();
      URL.revokeObjectURL(url);
    });

    portalBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      portalDropdown.classList.toggle('hidden');
      dropdownChevron.classList.toggle('rotate-180');
    });

    document.addEventListener('click', (e) => {
      const container = document.getElementById('portal-menu-container');
      if (container && !container.contains(e.target)) {
        portalDropdown.classList.add('hidden');
        dropdownChevron.classList.remove('rotate-180');
      }
    });
  </script>
</body>
</html>
