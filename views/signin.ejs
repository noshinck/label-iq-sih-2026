<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sign In - LabelIQ</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['Inter', 'sans-serif'] }
        }
      }
    }
  </script>
</head>
<body class="bg-[#FAFBFD] font-sans text-slate-800 min-h-screen flex items-center justify-center p-6 antialiased">

  <div class="w-full max-w-md bg-white rounded-3xl shadow-xl shadow-slate-200/50 border border-slate-100 p-8 sm:p-10 space-y-6">
    
    <!-- Header -->
    <div class="flex flex-col items-center text-center space-y-2">
      <div class="w-10 h-10 rounded-xl bg-[#4338CA] flex items-center justify-center text-white shadow-md shadow-indigo-600/20">
        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
          <path d="M4 6h2v2H4zm0 5h2v2H4zm0 5h2v2H4zm5-10h11v2H9zm0 5h11v2H9zm0 5h11v2H9z" />
        </svg>
      </div>
      <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Sign In</h1>
      <p class="text-sm text-slate-500">
        Portal: <strong class="text-[#4338CA] uppercase"><%= portal === 'legal' ? 'OFFICER' : (portal === 'consumer' ? 'PUBLIC' : portal) %></strong>
      </p>
    </div>

    <!-- Portal Switcher Tabs -->
    <div class="flex rounded-xl bg-slate-100 p-1 text-xs font-semibold text-slate-600">
      <a href="/signin?portal=consumer" class="flex-1 py-2 text-center rounded-lg <%= portal === 'consumer' ? 'bg-white text-slate-900 shadow-sm' : 'hover:text-slate-900' %>">Public</a>
      <a href="/signin?portal=business" class="flex-1 py-2 text-center rounded-lg <%= portal === 'business' ? 'bg-white text-slate-900 shadow-sm' : 'hover:text-slate-900' %>">Business</a>
      <a href="/signin?portal=legal" class="flex-1 py-2 text-center rounded-lg <%= portal === 'legal' ? 'bg-white text-slate-900 shadow-sm' : 'hover:text-slate-900' %>">Officer</a>
    </div>

    <!-- Credential Hint Box -->
    <div class="p-3.5 rounded-xl bg-indigo-50/60 border border-indigo-100 text-xs text-indigo-950 flex items-center justify-between">
      <div>
        <% if (portal === 'consumer') { %>
          <p><span class="font-semibold text-[#4338CA]">User:</span> admin</p>
          <p><span class="font-semibold text-[#4338CA]">Pass:</span> admin123</p>
        <% } else if (portal === 'business') { %>
          <p><span class="font-semibold text-[#4338CA]">User:</span> business_user</p>
          <p><span class="font-semibold text-[#4338CA]">Pass:</span> admin123</p>
        <% } else { %>
          <p><span class="font-semibold text-[#4338CA]">User:</span> inspector</p>
          <p><span class="font-semibold text-[#4338CA]">Pass:</span> admin123</p>
        <% } %>
      </div>
      <button 
        type="button" 
        onclick="fillCredentials('<%= portal %>')" 
        class="text-xs font-semibold text-[#4338CA] bg-white px-2.5 py-1.5 rounded-lg border border-indigo-200 hover:bg-indigo-50 transition-colors shadow-xs"
      >
        Auto Fill
      </button>
    </div>

    <!-- Error Alert -->
    <% if (error) { %>
      <div class="p-3 rounded-xl bg-red-50 border border-red-100 text-xs text-red-600 font-medium text-center">
        <%= error %>
      </div>
    <% } %>

    <!-- Form -->
    <form action="/signin" method="POST" class="space-y-4">
      <input type="hidden" name="targetPortal" value="<%= portal %>" />

      <div>
        <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Username</label>
        <input 
          type="text" 
          id="username" 
          name="username" 
          required 
          class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:border-[#4338CA] focus:ring-2 focus:ring-indigo-100 transition-all placeholder:text-slate-400"
        />
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Password</label>
        <input 
          type="password" 
          id="password" 
          name="password" 
          required 
          class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:border-[#4338CA] focus:ring-2 focus:ring-indigo-100 transition-all placeholder:text-slate-400"
        />
      </div>

      <button 
        type="submit" 
        class="w-full py-3 rounded-xl bg-[#4338CA] hover:bg-[#3730A3] text-white font-semibold text-sm shadow-md shadow-indigo-600/20 transition-all mt-2"
      >
        Sign In
      </button>
    </form>

    <% if (portal === 'consumer') { %>
      <form action="/auth/demo/public" method="POST">
        <button
          type="submit"
          class="w-full py-2.5 rounded-xl border border-slate-200 hover:bg-slate-50 text-sm font-semibold text-slate-700 transition-colors"
        >
          Continue as Demo
        </button>
      </form>
    <% } %>

    <!-- Sign Up Redirect Button / Link -->
    <div class="text-center pt-2 border-t border-slate-100">
      <p class="text-xs text-slate-500">
        Don't have an account for this portal?
      </p>
      <a 
        href="/signup?portal=<%= portal %>" 
        class="inline-block mt-2 px-4 py-2 rounded-xl border border-slate-200 hover:bg-slate-50 text-xs font-semibold text-slate-700 transition-colors"
      >
        Sign Up as <%= portal === 'legal' ? 'Officer' : (portal === 'consumer' ? 'Public' : 'Business') %>
      </a>
    </div>

  </div>

  <script>
    function fillCredentials(portal) {
      if (portal === 'consumer') {
        document.getElementById('username').value = 'admin';
        document.getElementById('password').value = 'admin123';
      } else if (portal === 'business') {
        document.getElementById('username').value = 'business_user';
        document.getElementById('password').value = 'admin123';
      } else if (portal === 'legal') {
        document.getElementById('username').value = 'inspector';
        document.getElementById('password').value = 'admin123';
      }
    }
  </script>
</body>
</html>
