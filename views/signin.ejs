<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sign In - LabelIQ</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['Inter', 'sans-serif'] },
          colors: { labelnavy: '#071b3a', labelblue: '#2563eb', labelcyan: '#06b6d4' }
        }
      }
    }
  </script>
  <style>
    .auth-orb {
      position: absolute;
      width: 18rem;
      height: 18rem;
      border-radius: 9999px;
      opacity: 0.16;
      filter: blur(48px);
      background: radial-gradient(circle, rgba(6, 182, 212, 0.8), rgba(37, 99, 235, 0.22) 58%, transparent 72%);
      pointer-events: none;
    }
    @media (prefers-reduced-motion: reduce) {
      .auth-orb { transform: none !important; }
    }
  </style>
</head>
<body class="min-h-screen overflow-x-hidden bg-[#f8fbff] font-sans text-slate-800 antialiased">
  <div class="pointer-events-none fixed inset-0 overflow-hidden">
    <div class="auth-orb left-[4%] top-[8%]" data-auth-orb></div>
    <div class="auth-orb right-[8%] top-[18%]" data-auth-orb></div>
    <div class="auth-orb bottom-[4%] left-[35%]" data-auth-orb></div>
  </div>

  <main class="relative mx-auto grid min-h-screen w-full max-w-7xl grid-cols-1 gap-8 px-4 py-6 sm:px-6 lg:grid-cols-[minmax(0,1fr)_440px] lg:items-center lg:px-10">
    <section class="flex min-h-[38vh] flex-col justify-between rounded-[2rem] border border-white/70 bg-white/55 px-5 py-5 shadow-sm shadow-slate-200/70 backdrop-blur sm:px-8 lg:min-h-[calc(100vh-5rem)] lg:py-8">
      <div class="flex items-center justify-between gap-4">
        <a href="/" class="inline-flex items-center">
          <img src="/assets/labeliq-logo.png" alt="LabelIQ" class="h-12 w-auto object-contain" />
        </a>
        <%- include('partials/language-selector') %>
      </div>

      <div class="max-w-2xl py-10 lg:py-0">
        <p class="text-sm font-bold uppercase tracking-[0.24em] text-labelblue" data-auth-text="subtitle">Smart Legal Metrology Compliance</p>
        <h1 class="mt-5 text-4xl font-extrabold tracking-tight text-labelnavy sm:text-5xl lg:text-6xl" data-auth-text="headline">Scan. Understand. Validate. Verify.</h1>
        <p class="mt-5 max-w-xl text-base leading-7 text-slate-600" data-auth-text="message">LabelIQ helps teams turn package images into readable declarations, evidence, and verification-ready compliance decisions.</p>
      </div>

      <div class="grid gap-3 sm:grid-cols-3 lg:max-w-3xl">
        <div class="rounded-2xl border border-slate-200/80 bg-white/80 p-4">
          <p class="text-sm font-bold text-labelnavy" data-auth-text="benefit_ocr">OCR extraction</p>
          <p class="mt-1 text-xs leading-5 text-slate-500" data-auth-text="benefit_ocr_copy">Read package declarations from uploaded images.</p>
        </div>
        <div class="rounded-2xl border border-slate-200/80 bg-white/80 p-4">
          <p class="text-sm font-bold text-labelnavy" data-auth-text="benefit_rules">Rule context</p>
          <p class="mt-1 text-xs leading-5 text-slate-500" data-auth-text="benefit_rules_copy">Review checks with Legal Metrology source context.</p>
        </div>
        <div class="rounded-2xl border border-slate-200/80 bg-white/80 p-4">
          <p class="text-sm font-bold text-labelnavy" data-auth-text="benefit_verify">Officer ready</p>
          <p class="mt-1 text-xs leading-5 text-slate-500" data-auth-text="benefit_verify_copy">Keep results ready for verification and reports.</p>
        </div>
      </div>
    </section>

    <section class="w-full">
      <div class="rounded-[1.75rem] border border-slate-200/80 bg-white/95 p-5 shadow-xl shadow-slate-200/60 sm:p-7">
        <div class="mb-6">
          <p class="text-sm font-semibold text-labelblue">LabelIQ</p>
          <h2 class="mt-2 text-2xl font-bold tracking-tight text-labelnavy" data-auth-text="signin_title">Sign in to your portal</h2>
          <p class="mt-2 text-sm text-slate-500"><span data-auth-text="portal">Portal</span>: <strong class="text-labelblue uppercase"><%= portal === 'legal' ? 'OFFICER' : (portal === 'consumer' ? 'PUBLIC' : portal) %></strong></p>
        </div>

        <div class="grid grid-cols-3 rounded-2xl bg-slate-100 p-1 text-xs font-bold text-slate-600">
          <a href="/signin?portal=consumer" class="rounded-xl py-2.5 text-center transition <%= portal === 'consumer' ? 'bg-white text-labelnavy shadow-sm' : 'hover:text-labelnavy' %>" data-auth-text="public">Public</a>
          <a href="/signin?portal=business" class="rounded-xl py-2.5 text-center transition <%= portal === 'business' ? 'bg-white text-labelnavy shadow-sm' : 'hover:text-labelnavy' %>" data-auth-text="business">Business</a>
          <a href="/signin?portal=legal" class="rounded-xl py-2.5 text-center transition <%= portal === 'legal' ? 'bg-white text-labelnavy shadow-sm' : 'hover:text-labelnavy' %>" data-auth-text="officer">Officer</a>
        </div>

        <% if (error || oauthError) { %>
          <div class="mt-4 rounded-2xl border border-red-100 bg-red-50 px-4 py-3 text-sm font-semibold text-red-600">
            <%= error || oauthError %>
          </div>
        <% } %>

        <div class="mt-5 space-y-4">
          <%- include('partials/google-oauth') %>
          <div class="flex items-center gap-3">
            <div class="h-px flex-1 bg-slate-200"></div>
            <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400" data-auth-text="or_password">or use password</span>
            <div class="h-px flex-1 bg-slate-200"></div>
          </div>
        </div>

        <form action="/signin" method="POST" class="mt-5 space-y-4" data-auth-form>
          <input type="hidden" name="targetPortal" value="<%= portal %>" />
          <div>
            <label for="username" class="mb-1.5 block text-xs font-bold uppercase tracking-wider text-slate-600" data-auth-text="email_username">Email / Username</label>
            <input id="username" type="text" name="username" required autocomplete="username" class="h-12 w-full rounded-2xl border border-slate-200 bg-white px-4 text-sm outline-none transition placeholder:text-slate-400 focus:border-labelblue focus:ring-4 focus:ring-blue-100" />
          </div>
          <div>
            <div class="mb-1.5 flex items-center justify-between gap-3">
              <label for="password" class="block text-xs font-bold uppercase tracking-wider text-slate-600" data-auth-text="password">Password</label>
              <a href="#" class="text-xs font-semibold text-labelblue hover:underline" data-auth-text="forgot_password">Forgot Password</a>
            </div>
            <input id="password" type="password" name="password" required autocomplete="current-password" class="h-12 w-full rounded-2xl border border-slate-200 bg-white px-4 text-sm outline-none transition placeholder:text-slate-400 focus:border-labelblue focus:ring-4 focus:ring-blue-100" />
          </div>
          <button type="submit" class="flex h-12 w-full items-center justify-center rounded-2xl bg-labelnavy text-sm font-bold text-white shadow-lg shadow-slate-900/15 transition hover:bg-[#0b2854] disabled:cursor-wait disabled:opacity-70" data-auth-submit data-auth-text="sign_in">Sign In</button>
        </form>

        <% if (portal === 'consumer') { %>
          <form action="/auth/demo/public" method="POST" class="mt-3" data-auth-form>
            <button type="submit" class="flex h-12 w-full items-center justify-center rounded-2xl border border-slate-200 bg-white text-sm font-bold text-labelnavy transition hover:bg-slate-50 disabled:cursor-wait disabled:opacity-70" data-auth-submit data-auth-text="continue_demo">Continue as Demo</button>
          </form>
        <% } %>

        <p class="mt-5 text-center text-sm text-slate-500">
          <span data-auth-text="no_account">Don't have an account?</span>
          <a href="/signup?portal=<%= portal %>" class="font-bold text-labelblue hover:underline" data-auth-text="create_account">Create Account</a>
        </p>

        <button type="button" onclick="fillCredentials('<%= portal %>')" class="mt-4 w-full rounded-2xl border border-blue-100 bg-blue-50/60 px-4 py-3 text-xs font-semibold text-labelblue transition hover:bg-blue-50" data-auth-text="use_demo_credentials">Use demo credentials</button>
      </div>
    </section>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js"></script>
  <script>
    window.LABELIQ_SUPABASE_URL = <%- JSON.stringify(supabase.url || '') %>;
    window.LABELIQ_SUPABASE_PUBLISHABLE_KEY = <%- JSON.stringify(supabase.publishableKey || '') %>;
  </script>
  <script src="/js/supabase-oauth.js"></script>
  <script src="/js/i18n.js"></script>
  <script src="/js/auth-ui.js"></script>
  <script>
    function fillCredentials(portal) {
      const values = portal === 'business'
        ? ['business_user', 'admin123']
        : (portal === 'legal' ? ['inspector', 'admin123'] : ['admin', 'admin123']);
      document.getElementById('username').value = values[0];
      document.getElementById('password').value = values[1];
    }
  </script>
</body>
</html>
