<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>PackCheck AI - Packaged Commodity Compliance Checker</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['Inter', 'sans-serif'] },
          colors: {
            ink: '#0b1f3a',
            navy: '#0f3564',
            gold: '#f2c94c',
            trust: '#13a46f'
          }
        }
      }
    }
  </script>
  <style>
    html { scroll-behavior: smooth; }
    body { letter-spacing: 0; }
    .hero-grid {
      background:
        linear-gradient(90deg, rgba(247, 251, 255, .96) 0%, rgba(247, 251, 255, .9) 48%, rgba(247, 251, 255, .64) 100%),
        radial-gradient(circle at 78% 28%, rgba(19, 164, 111, .14), transparent 28%),
        linear-gradient(180deg, #f7fbff 0%, #eef5fb 100%);
    }
    .audit-line {
      background-image: linear-gradient(90deg, rgba(15, 53, 100, .18) 1px, transparent 1px), linear-gradient(0deg, rgba(15, 53, 100, .12) 1px, transparent 1px);
      background-size: 56px 56px;
    }
    .product-shadow { filter: drop-shadow(0 30px 35px rgba(15, 53, 100, .2)); }
    @media (max-width: 768px) {
      .hero-grid { background: linear-gradient(180deg, #f7fbff 0%, #eef5fb 100%); }
    }
  </style>
</head>
<body class="bg-[#f4f8fc] text-slate-700 antialiased font-sans">
  <header class="sticky top-0 z-50 bg-white shadow-sm">
    <div class="bg-[#08284f] text-white">
      <div class="max-w-7xl mx-auto px-5 sm:px-8 h-10 flex items-center justify-between text-xs sm:text-sm">
        <div class="flex items-center gap-2 min-w-0">
          <span class="w-5 h-5 rounded-full bg-white text-[#08284f] grid place-items-center text-[11px] font-black">PC</span>
          <span class="font-semibold truncate">PackCheck AI - Legal Metrology Compliance Workspace</span>
        </div>
        <a href="/signin" class="hidden sm:inline-flex font-semibold hover:text-gold">Sign in</a>
      </div>
    </div>

    <div class="max-w-7xl mx-auto px-5 sm:px-8 py-6 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-5 bg-white">
      <a href="/" class="flex items-center gap-4">
        <div class="w-14 h-14 rounded-2xl bg-[#eef4fb] border border-[#dbe8f5] grid place-items-center text-navy">
          <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M7 3h10l3 4v14H4V7l3-4Z" />
            <path d="M8 12h8M8 16h5" />
            <path d="M8 7h8" />
          </svg>
        </div>
        <div>
          <p class="text-2xl font-black text-ink tracking-tight">PackCheck AI</p>
          <p class="text-sm text-slate-500">AI-powered packaged commodity compliance checker</p>
        </div>
      </a>

      <div class="flex flex-wrap items-center gap-3">
        <a href="/signin" class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-5 py-3 text-sm font-bold text-ink hover:border-slate-300">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><path d="M10 17l5-5-5-5"/><path d="M15 12H3"/></svg>
          Login
        </a>
        <a href="/officer/login" class="inline-flex items-center justify-center rounded-xl bg-navy px-6 py-3 text-sm font-bold text-white shadow-lg shadow-blue-900/20 hover:bg-[#0b294f]">
          Get Started
        </a>
      </div>
    </div>

    <nav class="bg-navy text-white">
      <div class="max-w-7xl mx-auto px-5 sm:px-8 h-auto md:h-14 flex flex-wrap items-center gap-1 md:gap-3 py-2 md:py-0 text-sm font-bold">
        <a href="/" class="px-4 py-3 border-b-2 border-gold text-white">Home</a>
        <a href="#about" class="px-4 py-3 text-blue-100 hover:text-white">About Us</a>
        <a href="#how" class="px-4 py-3 text-blue-100 hover:text-white">How It Works</a>
        <a href="#rules" class="px-4 py-3 text-blue-100 hover:text-white">Legal Metrology Rules</a>
        <a href="#portals" class="px-4 py-3 text-blue-100 hover:text-white">Guidelines</a>
        <a href="#contact" class="px-4 py-3 text-blue-100 hover:text-white">Contact Us</a>
      </div>
    </nav>
  </header>

  <main>
    <section class="hero-grid audit-line relative overflow-hidden">
      <div class="max-w-7xl mx-auto px-5 sm:px-8 py-14 lg:py-20 min-h-[650px] flex items-center">
        <div class="grid lg:grid-cols-[1fr_.95fr] gap-10 lg:gap-14 items-center w-full">
          <div class="relative z-10">
            <div class="inline-flex items-center gap-2 rounded-full border border-emerald-100 bg-white/90 px-4 py-2 text-sm font-extrabold text-ink shadow-sm">
              <span class="w-2 h-2 rounded-full bg-trust"></span>
              AI-Powered Verification Engine
            </div>

            <h1 class="mt-8 text-5xl sm:text-6xl font-black tracking-tight leading-[1.05] text-ink">
              Check Compliance.<br>
              <span class="text-trust">Build Trust.</span>
            </h1>

            <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-600">
              Scan any packaged commodity and verify declarations against Legal Metrology requirements using OCR, AI extraction, rule-based analysis and officer-verifiable evidence.
            </p>

            <div class="mt-8 flex flex-col sm:flex-row gap-3">
              <a href="/public/login" class="inline-flex justify-center rounded-xl bg-navy px-6 py-4 text-sm font-extrabold text-white shadow-lg shadow-blue-900/20 hover:bg-[#0b294f]">Scan Product</a>
              <a href="/officer/login" class="inline-flex justify-center rounded-xl border border-slate-200 bg-white px-6 py-4 text-sm font-extrabold text-ink hover:border-slate-300">Officer Portal</a>
            </div>

            <div class="mt-10 grid grid-cols-2 lg:grid-cols-4 gap-3 max-w-3xl">
              <% [
                ['Rule-Based', 'Verification per LM(PC) Rules'],
                ['AI-Powered OCR', 'High-accuracy declaration reading'],
                ['Instant Results', 'Compliant or needs verification'],
                ['Detailed Report', 'Evidence-backed reports']
              ].forEach(item => { %>
                <div class="rounded-2xl bg-white/92 border border-slate-200 p-4 shadow-sm">
                  <div class="w-9 h-9 rounded-xl bg-[#eef4fb] text-navy grid place-items-center mb-3">
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M20 6 9 17l-5-5"/></svg>
                  </div>
                  <h3 class="text-sm font-black text-ink"><%= item[0] %></h3>
                  <p class="mt-1 text-xs leading-5 text-slate-500"><%= item[1] %></p>
                </div>
              <% }) %>
            </div>
          </div>

          <div class="relative min-h-[500px] lg:min-h-[560px]" aria-label="Sample packaged commodity compliance preview">
            <div class="absolute inset-x-4 top-8 bottom-6 rounded-[34px] border-[10px] border-navy bg-white/82 shadow-2xl shadow-blue-950/10"></div>
            <div class="absolute left-0 sm:left-8 top-0 bottom-0 flex items-center">
              <img src="/assets/mountain-dew-can.png" alt="Mountain Dew can sample package used for compliance preview" class="product-shadow h-[420px] sm:h-[500px] w-auto object-contain" />
            </div>

            <div class="absolute right-0 sm:right-4 top-24 w-[260px] sm:w-[330px] rounded-[28px] border border-slate-200 bg-white/95 p-5 sm:p-6 shadow-2xl shadow-blue-950/10">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-full bg-emerald-50 text-trust grid place-items-center">
                  <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6 9 17l-5-5"/></svg>
                </div>
                <div>
                  <p class="text-lg font-black text-ink">Compliance Preview</p>
                  <p class="text-xs text-slate-500">Sample declaration scan</p>
                </div>
              </div>

              <div class="mt-6 space-y-3 text-sm">
                <div class="flex items-center justify-between rounded-xl bg-slate-50 px-4 py-3">
                  <span class="text-slate-500">Product</span>
                  <b class="text-ink">Mountain Dew</b>
                </div>
                <div class="flex items-center justify-between rounded-xl bg-slate-50 px-4 py-3">
                  <span class="text-slate-500">Net Qty</span>
                  <b class="text-ink">355 ml</b>
                </div>
                <div class="flex items-center justify-between rounded-xl bg-slate-50 px-4 py-3">
                  <span class="text-slate-500">MRP</span>
                  <b class="text-amber-700">Verify</b>
                </div>
                <div class="flex items-center justify-between rounded-xl bg-slate-50 px-4 py-3">
                  <span class="text-slate-500">Consumer Care</span>
                  <b class="text-emerald-700">Detected</b>
                </div>
              </div>

              <div class="mt-5 rounded-2xl bg-[#f8fbff] border border-blue-100 p-4">
                <div class="flex items-center justify-between text-xs font-bold text-slate-500">
                  <span>OCR Evidence</span>
                  <span class="text-trust">Active</span>
                </div>
                <div class="mt-3 h-2 rounded-full bg-slate-200 overflow-hidden">
                  <div class="h-full w-[78%] bg-trust"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="about" class="bg-white border-y border-slate-200">
      <div class="max-w-7xl mx-auto px-5 sm:px-8 py-14 grid lg:grid-cols-[.8fr_1.2fr] gap-10">
        <div>
          <p class="text-xs font-black uppercase tracking-[0.24em] text-trust">About PackCheck AI</p>
          <h2 class="mt-3 text-3xl font-black tracking-tight text-ink">A practical compliance layer for packaged commodities.</h2>
        </div>
        <p class="text-base leading-8 text-slate-600">
          PackCheck AI helps consumers, businesses and legal metrology officers scan package images, extract label declarations, retrieve relevant legal context and verify compliance with transparent evidence.
        </p>
      </div>
    </section>

    <section id="how" class="max-w-7xl mx-auto px-5 sm:px-8 py-16">
      <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-4">
        <div>
          <p class="text-xs font-black uppercase tracking-[0.24em] text-trust">How It Works</p>
          <h2 class="mt-3 text-3xl font-black tracking-tight text-ink">Scan to result in one guided workflow.</h2>
        </div>
        <a href="/public/login" class="inline-flex w-fit rounded-xl border border-slate-200 bg-white px-5 py-3 text-sm font-bold text-ink hover:border-slate-300">Try consumer scan</a>
      </div>

      <div class="mt-8 grid md:grid-cols-4 gap-4">
        <% [
          ['01', 'Upload Photo', 'Front, back, side or label close-up product images.'],
          ['02', 'Run OCR', 'Text is extracted from the uploaded package image.'],
          ['03', 'Check Rules', 'Declarations are mapped to applicable legal checks.'],
          ['04', 'Review Evidence', 'Open findings with source image context.']
        ].forEach(step => { %>
          <div class="rounded-2xl bg-white border border-slate-200 p-6 shadow-sm">
            <span class="text-sm font-black text-trust"><%= step[0] %></span>
            <h3 class="mt-4 text-base font-black text-ink"><%= step[1] %></h3>
            <p class="mt-2 text-sm leading-6 text-slate-600"><%= step[2] %></p>
          </div>
        <% }) %>
      </div>
    </section>

    <section id="rules" class="bg-[#eef5fb] border-y border-slate-200">
      <div class="max-w-7xl mx-auto px-5 sm:px-8 py-16">
        <p class="text-xs font-black uppercase tracking-[0.24em] text-trust">Legal Metrology Knowledge</p>
        <h2 class="mt-3 text-3xl font-black tracking-tight text-ink">Grounded in source documents, checked by deterministic rules.</h2>
        <div class="mt-8 grid md:grid-cols-3 gap-4">
          <div class="rounded-2xl bg-white border border-slate-200 p-6 shadow-sm">
            <h3 class="font-black text-ink">Legal Metrology Act, 2009</h3>
            <p class="mt-2 text-sm text-slate-600 leading-6">Core statutory framework for weights, measures and enforcement.</p>
          </div>
          <div class="rounded-2xl bg-white border border-slate-200 p-6 shadow-sm">
            <h3 class="font-black text-ink">Packaged Commodities Rules, 2011</h3>
            <p class="mt-2 text-sm text-slate-600 leading-6">Declarations, retail sale price, quantity and package rules.</p>
          </div>
          <div class="rounded-2xl bg-white border border-slate-200 p-6 shadow-sm">
            <h3 class="font-black text-ink">National Standards Rules, 2019</h3>
            <p class="mt-2 text-sm text-slate-600 leading-6">Measurement standards and supporting legal context.</p>
          </div>
        </div>
      </div>
    </section>

    <section id="portals" class="max-w-7xl mx-auto px-5 sm:px-8 py-16">
      <div class="text-center max-w-2xl mx-auto">
        <p class="text-xs font-black uppercase tracking-[0.24em] text-trust">Guidelines</p>
        <h2 class="mt-3 text-3xl font-black tracking-tight text-ink">Choose your workflow.</h2>
      </div>

      <div class="mt-8 grid md:grid-cols-3 gap-4">
        <a href="/public/login" class="rounded-2xl bg-white border border-slate-200 p-6 shadow-sm hover:-translate-y-1 hover:shadow-xl transition">
          <h3 class="text-lg font-black text-ink">Consumer Portal</h3>
          <p class="mt-2 text-sm leading-6 text-slate-600">Scan products and submit suspected packaging issues.</p>
          <span class="mt-6 inline-flex text-sm font-black text-navy">Open portal</span>
        </a>
        <a href="/business/login" class="rounded-2xl bg-white border border-slate-200 p-6 shadow-sm hover:-translate-y-1 hover:shadow-xl transition">
          <h3 class="text-lg font-black text-ink">Business Portal</h3>
          <p class="mt-2 text-sm leading-6 text-slate-600">Check artwork and labels before market release.</p>
          <span class="mt-6 inline-flex text-sm font-black text-navy">Open portal</span>
        </a>
        <a href="/officer/login" class="rounded-2xl bg-white border border-slate-200 p-6 shadow-sm hover:-translate-y-1 hover:shadow-xl transition">
          <h3 class="text-lg font-black text-ink">Officer Portal</h3>
          <p class="mt-2 text-sm leading-6 text-slate-600">Inspect, verify evidence and finalize compliance reports.</p>
          <span class="mt-6 inline-flex text-sm font-black text-navy">Open portal</span>
        </a>
      </div>
    </section>
  </main>

  <footer id="contact" class="bg-[#08284f] text-blue-100">
    <div class="max-w-7xl mx-auto px-5 sm:px-8 py-8 flex flex-col sm:flex-row gap-3 items-center justify-between text-sm">
      <p class="font-bold text-white">PackCheck AI</p>
      <p>AI-powered packaged commodity compliance checker for SIH 2026.</p>
    </div>
  </footer>
</body>
</html>
