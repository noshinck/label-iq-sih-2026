<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>PackCheck AI - AI-Powered Legal Metrology Compliance</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/gsap.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/ScrollTrigger.min.js"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['Inter', 'sans-serif'] },
          colors: {
            ink: '#08111f',
            muted: '#667085',
            line: '#e6eaf0',
            brand: '#1d4ed8',
            accent: '#4f46e5'
          }
        }
      }
    }
  </script>
  <style>
    html { scroll-behavior: smooth; }
    .glass { background: rgba(255,255,255,.82); backdrop-filter: blur(18px); }
    .soft-shadow { box-shadow: 0 20px 60px rgba(15, 23, 42, .08); }
    .preview-grid { background-image: radial-gradient(#cbd5e1 1px, transparent 1px); background-size: 18px 18px; }
    @media (prefers-reduced-motion: reduce) {
      * { scroll-behavior: auto !important; animation: none !important; transition: none !important; }
    }
  </style>
</head>
<body class="bg-[#f6f8fb] text-ink antialiased font-sans">
  <header class="sticky top-0 z-50 border-b border-line/80 glass">
    <div class="max-w-7xl mx-auto px-5 sm:px-8 h-16 flex items-center justify-between">
      <a href="/" class="flex items-center gap-3" aria-label="PackCheck AI home">
        <div class="w-9 h-9 rounded-xl bg-ink text-white flex items-center justify-center shadow-sm">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
            <path d="M5 7h2M11 7h8M5 12h2M11 12h8M5 17h2M11 17h8" />
          </svg>
        </div>
        <span class="text-lg font-extrabold tracking-tight">PackCheck AI</span>
      </a>

      <nav class="hidden lg:flex items-center gap-7 text-sm font-medium text-slate-600">
        <a href="#product" class="hover:text-ink">Product</a>
        <a href="#how" class="hover:text-ink">How It Works</a>
        <a href="#features" class="hover:text-ink">Features</a>
        <a href="#business" class="hover:text-ink">For Business</a>
        <a href="#officers" class="hover:text-ink">For Officers</a>
        <a href="#about" class="hover:text-ink">About</a>
      </nav>

      <div class="flex items-center gap-2">
        <a href="/signin" class="hidden sm:inline-flex px-4 py-2 rounded-xl text-sm font-semibold text-slate-700 hover:bg-white border border-transparent hover:border-line">Sign In</a>
        <a href="/officer/login" class="inline-flex px-4 py-2 rounded-xl text-sm font-semibold text-white bg-ink hover:bg-slate-800 shadow-sm">Get Started</a>
      </div>
    </div>
  </header>

  <main>
    <section class="relative overflow-hidden">
      <div class="absolute inset-x-0 top-0 h-[520px] bg-gradient-to-b from-white to-transparent pointer-events-none"></div>
      <div class="max-w-7xl mx-auto px-5 sm:px-8 pt-20 sm:pt-24 pb-16 relative">
        <div class="grid lg:grid-cols-[1fr_1.05fr] gap-12 items-center">
          <div class="hero-copy">
            <div class="inline-flex items-center gap-2 rounded-full border border-line bg-white px-3 py-1.5 text-xs font-semibold text-slate-600 shadow-sm">
              <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
              Built for Government Officers, Businesses & Consumers
            </div>
            <h1 class="mt-6 text-5xl sm:text-6xl font-black tracking-[-0.04em] leading-[1.02] text-ink">
              AI-Powered Legal Metrology Compliance
            </h1>
            <p class="mt-5 max-w-2xl text-base sm:text-lg text-slate-600 leading-8">
              Scan packaged commodities, automatically extract declarations, analyze applicable Legal Metrology requirements, and generate evidence-backed compliance reports.
            </p>
            <div class="mt-8 flex flex-col sm:flex-row gap-3">
              <a href="/officer/login" class="inline-flex justify-center px-5 py-3 rounded-2xl bg-brand text-white text-sm font-bold shadow-lg shadow-blue-700/15 hover:bg-blue-700">Start Inspection</a>
              <a href="#product" class="inline-flex justify-center px-5 py-3 rounded-2xl bg-white border border-line text-sm font-bold text-slate-800 hover:border-slate-300">Explore Platform</a>
            </div>
          </div>

          <div id="product" class="hero-preview rounded-[28px] border border-line bg-white p-3 soft-shadow">
            <div class="rounded-[22px] overflow-hidden bg-[#f8fafc] border border-slate-100">
              <div class="h-12 px-4 flex items-center justify-between border-b border-line bg-white">
                <div class="flex items-center gap-2">
                  <span class="w-3 h-3 rounded-full bg-red-400"></span>
                  <span class="w-3 h-3 rounded-full bg-amber-400"></span>
                  <span class="w-3 h-3 rounded-full bg-emerald-400"></span>
                </div>
                <div class="text-xs font-semibold text-slate-400">Inspection Preview</div>
              </div>

              <div class="grid md:grid-cols-[.9fr_1.1fr] gap-4 p-4 preview-grid">
                <div class="rounded-2xl bg-white border border-line p-4">
                  <div class="aspect-[4/5] rounded-xl bg-gradient-to-br from-blue-50 to-slate-100 border border-blue-100 relative overflow-hidden">
                    <div class="absolute left-8 right-8 top-10 h-12 rounded-lg bg-white/90 border border-slate-200"></div>
                    <div class="absolute left-8 right-8 top-28 h-24 rounded-lg bg-blue-600/10 border border-blue-300"></div>
                    <div class="absolute left-8 right-8 bottom-16 h-14 rounded-lg bg-white/90 border border-slate-200"></div>
                    <div class="absolute right-9 bottom-[72px] w-24 h-7 rounded-md border-2 border-red-500 bg-red-500/10"></div>
                  </div>
                  <div class="mt-3 text-xs font-semibold text-slate-500">Actual image + OCR evidence regions</div>
                </div>

                <div class="space-y-3">
                  <div class="rounded-2xl bg-white border border-line p-4">
                    <div class="flex items-center justify-between">
                      <h3 class="text-sm font-bold text-ink">AI Extraction</h3>
                      <span class="text-[11px] font-bold rounded-full bg-emerald-50 text-emerald-700 px-2 py-1">OCR 96%</span>
                    </div>
                    <div class="mt-4 grid grid-cols-2 gap-2 text-xs">
                      <div class="rounded-xl bg-slate-50 p-3"><span class="block text-slate-400">MRP</span><b>Rs. 5.00</b></div>
                      <div class="rounded-xl bg-slate-50 p-3"><span class="block text-slate-400">Use By</span><b>02/01/27</b></div>
                      <div class="rounded-xl bg-slate-50 p-3"><span class="block text-slate-400">Manufacturer</span><b>Detected</b></div>
                      <div class="rounded-xl bg-slate-50 p-3"><span class="block text-slate-400">Net Quantity</span><b>Needs review</b></div>
                    </div>
                  </div>

                  <div class="rounded-2xl bg-white border border-line p-4">
                    <div class="flex items-center justify-between">
                      <h3 class="text-sm font-bold text-ink">Compliance Result</h3>
                      <span class="text-[11px] font-bold rounded-full bg-amber-50 text-amber-700 px-2 py-1">Needs Verification</span>
                    </div>
                    <div class="mt-4 space-y-2 text-xs">
                      <div class="flex items-center justify-between rounded-xl bg-slate-50 p-3"><span>MRP declaration</span><b class="text-amber-700">Verify</b></div>
                      <div class="flex items-center justify-between rounded-xl bg-slate-50 p-3"><span>Date declaration</span><b class="text-emerald-700">Passed</b></div>
                      <div class="flex items-center justify-between rounded-xl bg-slate-50 p-3"><span>Rule context</span><b>LM(PC) Rules</b></div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="how" class="max-w-7xl mx-auto px-5 sm:px-8 py-16">
      <div class="max-w-2xl">
        <p class="text-xs font-extrabold uppercase tracking-[0.2em] text-brand">How It Works</p>
        <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-ink">Scan to evidence-backed compliance in four steps.</h2>
      </div>
      <div class="mt-8 grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <% [
          ['01', 'SCAN', 'Take or upload product photos.'],
          ['02', 'UNDERSTAND', 'OCR + AI extracts package information.'],
          ['03', 'VALIDATE', 'Applicable Legal Metrology rules are checked.'],
          ['04', 'VERIFY', 'Evidence is reviewed and report is generated.']
        ].forEach(step => { %>
          <div class="reveal rounded-3xl bg-white border border-line p-6 soft-shadow">
            <span class="text-xs font-black text-brand"><%= step[0] %></span>
            <h3 class="mt-4 text-sm font-extrabold tracking-wide text-ink"><%= step[1] %></h3>
            <p class="mt-2 text-sm text-slate-600 leading-6"><%= step[2] %></p>
          </div>
        <% }) %>
      </div>
    </section>

    <section id="features" class="max-w-7xl mx-auto px-5 sm:px-8 py-16">
      <div class="grid lg:grid-cols-[.8fr_1.2fr] gap-10">
        <div>
          <p class="text-xs font-extrabold uppercase tracking-[0.2em] text-brand">Platform</p>
          <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-ink">One product intelligence layer for every workflow.</h2>
          <p class="mt-4 text-sm text-slate-600 leading-7">PackCheck AI keeps scanning, legal retrieval, deterministic checks, evidence and reports connected in one workflow.</p>
        </div>
        <div class="grid sm:grid-cols-2 gap-3">
          <% [
            ['AI Product Scanning', 'Image-first package inspection from camera or upload.'],
            ['OCR & Declaration Extraction', 'Detect package text, confidence and bounding boxes.'],
            ['Legal Metrology RAG', 'Retrieve source context from Legal Metrology documents.'],
            ['Deterministic Rule Engine', 'Run transparent checks instead of asking AI to decide legality.'],
            ['Evidence & Highlighting', 'Show the source image region behind each finding.'],
            ['Officer Verification', 'Accept, edit, reject and store officer decisions.'],
            ['Compliance Reports', 'Generate PDF and DOCX inspection outputs.'],
            ['Business Self-Check', 'Pre-check artwork and product labels before production.']
          ].forEach(feature => { %>
            <div class="reveal rounded-2xl bg-white border border-line p-5 hover:-translate-y-0.5 hover:shadow-lg transition">
              <div class="w-9 h-9 rounded-xl bg-blue-50 text-brand flex items-center justify-center mb-4">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path d="M5 12h14M12 5v14"/></svg>
              </div>
              <h3 class="text-sm font-bold text-ink"><%= feature[0] %></h3>
              <p class="mt-2 text-sm text-slate-600 leading-6"><%= feature[1] %></p>
            </div>
          <% }) %>
        </div>
      </div>
    </section>

    <section id="about" class="max-w-7xl mx-auto px-5 sm:px-8 py-16">
      <div class="rounded-[32px] bg-ink text-white p-6 sm:p-10 overflow-hidden">
        <div class="grid lg:grid-cols-[.9fr_1.1fr] gap-10 items-center">
          <div>
            <p class="text-xs font-extrabold uppercase tracking-[0.2em] text-blue-200">Legal Intelligence</p>
            <h2 class="mt-3 text-3xl font-extrabold tracking-tight">Built on the Legal Metrology Knowledge Base</h2>
            <p class="mt-4 text-sm text-slate-300 leading-7">The system retrieves relevant source context before deterministic validation. Officers remain the final verification authority.</p>
          </div>
          <div class="grid sm:grid-cols-3 gap-3 text-sm">
            <div class="rounded-2xl bg-white/8 border border-white/10 p-4">Legal Metrology Act, 2009</div>
            <div class="rounded-2xl bg-white/8 border border-white/10 p-4">Packaged Commodities Rules, 2011</div>
            <div class="rounded-2xl bg-white/8 border border-white/10 p-4">National Standards Rules, 2019</div>
          </div>
        </div>
      </div>
    </section>

    <section id="business" class="max-w-7xl mx-auto px-5 sm:px-8 py-16">
      <div class="text-center max-w-2xl mx-auto">
        <p class="text-xs font-extrabold uppercase tracking-[0.2em] text-brand">Portals</p>
        <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-ink">One Platform. Three Workflows.</h2>
      </div>
      <div class="mt-8 grid md:grid-cols-3 gap-4">
        <a href="/officer/login" id="officers" class="reveal rounded-3xl bg-white border border-line p-6 hover:-translate-y-1 hover:shadow-xl transition">
          <h3 class="text-lg font-extrabold text-ink">Government Officer</h3>
          <p class="mt-2 text-sm text-slate-600 leading-6">Inspect packages, review findings and generate reports.</p>
          <span class="mt-6 inline-flex text-sm font-bold text-brand">Enter Officer Portal</span>
        </a>
        <a href="/business/login" class="reveal rounded-3xl bg-white border border-line p-6 hover:-translate-y-1 hover:shadow-xl transition">
          <h3 class="text-lg font-extrabold text-ink">Business Owner</h3>
          <p class="mt-2 text-sm text-slate-600 leading-6">Pre-check packaging before production and fix issues.</p>
          <span class="mt-6 inline-flex text-sm font-bold text-brand">Enter Business Portal</span>
        </a>
        <a href="/public/login" class="reveal rounded-3xl bg-white border border-line p-6 hover:-translate-y-1 hover:shadow-xl transition">
          <h3 class="text-lg font-extrabold text-ink">Public / Consumer</h3>
          <p class="mt-2 text-sm text-slate-600 leading-6">Scan products and report suspected issues.</p>
          <span class="mt-6 inline-flex text-sm font-bold text-brand">Enter Consumer Portal</span>
        </a>
      </div>
    </section>
  </main>

  <footer class="border-t border-line bg-white">
    <div class="max-w-7xl mx-auto px-5 sm:px-8 py-8 flex flex-col sm:flex-row gap-3 items-center justify-between text-sm text-slate-500">
      <p>PackCheck AI</p>
      <p>Compliance screening for packaged commodities.</p>
    </div>
  </footer>

  <script>
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && window.gsap) {
      gsap.registerPlugin(ScrollTrigger);
      gsap.from('.hero-copy > *', { y: 18, opacity: 0, duration: 0.55, stagger: 0.08, ease: 'power2.out' });
      gsap.from('.hero-preview', { y: 24, opacity: 0, duration: 0.7, ease: 'power2.out', delay: 0.12 });
      gsap.utils.toArray('.reveal').forEach((item) => {
        gsap.from(item, {
          y: 18,
          opacity: 0,
          duration: 0.45,
          ease: 'power2.out',
          scrollTrigger: { trigger: item, start: 'top 88%' }
        });
      });
    }
  </script>
</body>
</html>
