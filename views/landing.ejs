<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>PackCheck AI - Packaged Commodity Compliance Checker</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['Inter', 'sans-serif'] },
          colors: {
            ink: '#101828',
            trust: '#12a36f',
            navy: '#0f3564'
          }
        }
      }
    }
  </script>
  <style>
    html { scroll-behavior: smooth; }
    body { letter-spacing: 0; }
    .soft-border { border-color: rgba(15, 53, 100, .10); }
    .hero-wash {
      background:
        radial-gradient(circle at 78% 12%, rgba(59, 130, 246, .20), transparent 24%),
        radial-gradient(circle at 28% 86%, rgba(14, 165, 233, .16), transparent 28%),
        linear-gradient(135deg, #ffffff 0%, #f6fbff 38%, #eaf4ff 72%, #d9ecff 100%);
    }
    .blue-glow {
      background: radial-gradient(circle, rgba(37, 99, 235, .20), transparent 62%);
      filter: blur(22px);
    }
    .product-shadow { filter: drop-shadow(0 22px 28px rgba(15, 53, 100, .16)); }
    .tilt-card { transform: rotate(-3deg); transform-origin: center; }
    @media (max-width: 900px) {
      .tilt-card { transform: none; }
    }
  </style>
</head>
<body class="bg-[#f7faff] text-ink antialiased font-sans">
  <header class="fixed inset-x-0 top-0 z-50 px-3 pt-3">
    <div class="mx-auto max-w-7xl rounded-2xl border soft-border bg-white/88 px-4 py-3 shadow-sm shadow-blue-950/5 backdrop-blur-xl sm:px-6">
      <div class="flex items-center justify-between gap-4">
        <a href="/" class="flex items-center gap-2.5">
          <span class="grid h-9 w-9 place-items-center rounded-xl bg-[#0f3564] text-white shadow-sm shadow-blue-950/20">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M7 3h10l3 4v14H4V7l3-4Z" />
              <path d="M8 12h8M8 16h5M8 7h8" />
            </svg>
          </span>
          <span class="text-sm font-black tracking-tight sm:text-base">PackCheck AI</span>
        </a>

        <nav class="hidden items-center gap-6 text-xs font-bold text-slate-600 md:flex">
          <a href="#workflow" class="hover:text-ink">Workflow</a>
          <a href="#features" class="hover:text-ink">Features</a>
          <a href="#rules" class="hover:text-ink">Rules</a>
          <a href="#portals" class="hover:text-ink">Portals</a>
          <a href="#faq" class="hover:text-ink">FAQ</a>
        </nav>

        <div class="flex items-center gap-2">
          <a href="/signin" class="hidden rounded-full px-4 py-2 text-xs font-black text-ink hover:bg-slate-100 sm:inline-flex">Sign in</a>
          <a href="/public/login" class="rounded-full bg-[#2563eb] px-4 py-2 text-xs font-black text-white shadow-lg shadow-blue-600/20 hover:bg-[#1d4ed8]">Scan now</a>
        </div>
      </div>
    </div>
  </header>

  <main class="pt-3">
    <section class="mx-auto max-w-[1500px] px-3">
      <div class="hero-wash relative overflow-hidden rounded-[28px] border soft-border px-5 pb-10 pt-28 shadow-2xl shadow-blue-950/5 sm:px-10 lg:px-16 lg:pb-16 lg:pt-32">
        <div class="grid min-h-[560px] items-center gap-10 lg:grid-cols-[.92fr_1.08fr]">
          <div class="relative z-10 max-w-2xl">
            <p class="text-[11px] font-black uppercase tracking-[0.18em] text-[#2563eb]">AI package compliance for Legal Metrology</p>
            <h1 class="mt-5 text-5xl font-black leading-[.98] tracking-tight text-ink sm:text-7xl">
              Scan labels.<br>
              Catch issues.<br>
              <span class="text-[#2563eb]">Prove it.</span>
            </h1>
            <p class="mt-6 max-w-xl text-lg leading-8 text-slate-700">
              PackCheck AI turns product photos into extracted declarations, rule checks, evidence highlights and officer-ready compliance reports.
            </p>

            <div class="mt-8 flex flex-col gap-3 sm:flex-row">
              <a href="/public/login" class="inline-flex justify-center rounded-full bg-[#2563eb] px-6 py-3 text-sm font-black text-white shadow-xl shadow-blue-600/20 hover:bg-[#1d4ed8]">Start consumer scan</a>
              <a href="/officer/login" class="inline-flex justify-center rounded-full border border-black/10 bg-white px-6 py-3 text-sm font-black text-ink hover:border-black/20">Officer portal</a>
            </div>

            <div class="mt-8 rounded-2xl border soft-border bg-white/82 p-4 shadow-xl shadow-blue-950/5 backdrop-blur">
              <div class="flex items-start gap-3">
                <div class="h-9 w-9 shrink-0 overflow-hidden rounded-full bg-gradient-to-br from-[#1d4ed8] to-[#38bdf8]"></div>
                <p class="text-sm leading-6 text-slate-700">
                  <b class="text-ink">Field-ready flow:</b> upload front and back photos, run OCR, retrieve legal context, verify findings, then save the inspection.
                </p>
              </div>
            </div>
          </div>

          <div class="relative min-h-[520px]">
            <div class="blue-glow absolute -bottom-10 left-20 h-52 w-72"></div>
            <div class="tilt-card absolute right-0 top-12 w-[78%] rounded-[26px] border soft-border bg-white p-5 shadow-2xl shadow-blue-950/10">
              <div class="flex items-center justify-between border-b border-slate-100 pb-4">
                <div>
                  <p class="text-[11px] font-black uppercase tracking-[0.16em] text-slate-400">Inspection preview</p>
                  <p class="text-xl font-black text-ink">Mountain Dew label</p>
                </div>
                <span class="rounded-full bg-blue-50 px-3 py-1 text-xs font-black text-[#2563eb]">OCR active</span>
              </div>
              <div class="mt-5 grid grid-cols-[.85fr_1fr] gap-4">
                <div class="rounded-3xl bg-[#f6f9ff] p-3 ring-1 ring-blue-100/70">
                  <img src="/assets/mountain-dew-can.png" alt="Mountain Dew back-label sample package used for compliance preview" class="product-shadow mx-auto max-h-[355px] object-contain" />
                </div>
                <div class="space-y-3">
                  <% [
                    ['Product', 'Mountain Dew'],
                    ['Net Qty', '250 ml'],
                    ['Caffeine Warning', 'Detected'],
                    ['MRP', 'Verify']
                  ].forEach(row => { %>
                    <div class="rounded-2xl bg-slate-50 p-4">
                      <p class="text-xs font-bold text-slate-400"><%= row[0] %></p>
                      <p class="mt-1 text-sm font-black text-ink"><%= row[1] %></p>
                    </div>
                  <% }) %>
                </div>
              </div>
            </div>

            <div class="absolute bottom-8 left-0 w-[58%] rounded-3xl border soft-border bg-white p-5 shadow-2xl shadow-blue-950/10">
              <p class="text-[11px] font-black uppercase tracking-[0.16em] text-slate-400">Compliance result</p>
              <div class="mt-4 flex items-center justify-between">
                <div>
                  <p class="text-2xl font-black text-ink">Needs Verification</p>
                  <p class="mt-1 text-sm text-slate-500">2 fields require officer review</p>
                </div>
                <div class="grid h-12 w-12 place-items-center rounded-full bg-blue-50 text-[#2563eb]">
                  <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M12 9v4M12 17h.01M10.3 4.3 2.7 17.5A2 2 0 0 0 4.4 20h15.2a2 2 0 0 0 1.7-2.5L13.7 4.3a2 2 0 0 0-3.4 0Z"/></svg>
                </div>
              </div>
              <div class="mt-5 h-2 rounded-full bg-slate-100">
                <div class="h-2 w-[68%] rounded-full bg-[#2563eb]"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="workflow" class="mx-auto max-w-7xl px-5 py-20 sm:px-8">
      <div class="text-center">
        <p class="text-[11px] font-black uppercase tracking-[0.2em] text-slate-400">No more scattered checks</p>
        <h2 class="mt-3 text-3xl font-black tracking-tight sm:text-4xl">One workflow replaces point solutions.</h2>
      </div>
      <div class="mx-auto mt-8 grid max-w-5xl grid-cols-2 gap-3 rounded-3xl border soft-border bg-white p-4 shadow-2xl shadow-slate-900/10 md:grid-cols-4">
        <% ['Upload', 'OCR', 'AI extraction', 'Legal context', 'Rule engine', 'Evidence', 'Verification', 'Reports'].forEach(item => { %>
          <div class="rounded-2xl border soft-border bg-[#fbfbf9] px-4 py-5 text-center text-sm font-black text-slate-700"><%= item %></div>
        <% }) %>
      </div>
      <div class="mt-8 grid gap-5 md:grid-cols-3">
        <% [
          {
            title: 'Upload photos',
            description: 'Front, back, side, top, bottom and close-up label images stay attached to one product record.',
            icon: '<path d="M12 16V4"/><path d="m7 9 5-5 5 5"/><path d="M20 16v3a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-3"/>'
          },
          {
            title: 'Extract declarations',
            description: 'The system reads package text and converts it into structured fields for review.',
            icon: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><path d="M14 2v6h6"/><path d="M8 13h8"/><path d="M8 17h5"/>'
          },
          {
            title: 'Save evidence',
            description: 'Findings point back to uploaded package images and OCR text.',
            icon: '<path d="M9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>'
          }
        ].forEach(card => { %>
          <div class="rounded-3xl bg-white p-6 shadow-sm shadow-blue-950/5 ring-1 ring-blue-100/70">
            <div class="grid h-12 w-12 place-items-center rounded-2xl bg-gradient-to-br from-[#2563eb] to-[#38bdf8] text-white shadow-lg shadow-blue-500/20">
              <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><%- card.icon %></svg>
            </div>
            <h3 class="mt-5 text-lg font-black text-ink"><%= card.title %></h3>
            <p class="mt-2 text-sm leading-6 text-slate-600"><%= card.description %></p>
          </div>
        <% }) %>
      </div>
    </section>

    <section id="features" class="mx-auto max-w-7xl px-5 py-10 sm:px-8">
      <div class="space-y-8">
        <div class="grid items-center gap-8 rounded-[28px] border soft-border bg-white p-6 shadow-sm shadow-blue-950/5 md:grid-cols-[.95fr_1.05fr] md:p-10">
          <div class="rounded-3xl bg-gradient-to-br from-[#eff6ff] via-white to-[#dbeafe] p-6 shadow-xl shadow-blue-950/5">
            <div class="grid grid-cols-2 gap-3">
              <% ['Product name', 'Manufacturer', 'MRP', 'Net quantity', 'Country', 'Consumer care'].forEach(item => { %>
                <div class="rounded-2xl bg-white/90 p-4 text-sm font-black text-slate-700 shadow-sm"><%= item %></div>
              <% }) %>
            </div>
          </div>
          <div>
            <p class="text-[11px] font-black uppercase tracking-[0.2em] text-[#2563eb]">AI extraction</p>
            <h2 class="mt-3 text-3xl font-black tracking-tight">From blurry package photos to structured declarations.</h2>
            <p class="mt-4 text-sm leading-7 text-slate-600">PackCheck AI combines OCR and backend AI extraction so officers and businesses can review the exact fields that matter for packaged commodities.</p>
          </div>
        </div>

        <div class="grid items-center gap-8 rounded-[28px] border soft-border bg-white p-6 shadow-sm shadow-blue-950/5 md:grid-cols-[1.05fr_.95fr] md:p-10">
          <div>
            <p class="text-[11px] font-black uppercase tracking-[0.2em] text-[#2563eb]">Rule validation</p>
            <h2 class="mt-3 text-3xl font-black tracking-tight">Legal checks that explain what passed and what needs review.</h2>
            <p class="mt-4 text-sm leading-7 text-slate-600">The rule engine uses retrieved legal context, deterministic checks and evidence records instead of asking AI to directly decide legality.</p>
          </div>
          <div class="rounded-3xl bg-gradient-to-br from-[#0f3564] to-[#101828] p-5 text-white shadow-2xl shadow-blue-950/20">
            <% [
              ['MRP declaration', 'Needs verification'],
              ['Net quantity', 'Passed'],
              ['Consumer care', 'Passed'],
              ['Date declaration', 'Review']
            ].forEach(row => { %>
              <div class="mb-3 flex items-center justify-between rounded-2xl bg-slate-50 p-4 last:mb-0">
                <span class="text-sm font-bold"><%= row[0] %></span>
                <span class="rounded-full bg-white px-3 py-1 text-xs font-black text-ink"><%= row[1] %></span>
              </div>
            <% }) %>
          </div>
        </div>
      </div>
    </section>

    <section id="rules" class="mx-auto max-w-7xl px-5 py-20 sm:px-8">
      <div class="text-center">
        <p class="text-[11px] font-black uppercase tracking-[0.2em] text-slate-400">Source-grounded</p>
        <h2 class="mt-3 text-3xl font-black tracking-tight sm:text-4xl">Built around the legal documents in your project.</h2>
      </div>
      <div class="mt-8 grid gap-4 md:grid-cols-3">
        <% [
          ['Legal Metrology Act, 2009', 'Core statutory framework for enforcement and standards.'],
          ['Packaged Commodities Rules, 2011', 'Declarations, MRP, quantity, dates and package requirements.'],
          ['National Standards Rules, 2019', 'Measurement standards and supporting legal context.']
        ].forEach(doc => { %>
          <div class="rounded-3xl border soft-border bg-white p-6 shadow-sm shadow-blue-950/5">
            <h3 class="font-black text-ink"><%= doc[0] %></h3>
            <p class="mt-3 text-sm leading-6 text-slate-600"><%= doc[1] %></p>
          </div>
        <% }) %>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-5 py-10 sm:px-8">
      <div class="text-center">
        <p class="text-[11px] font-black uppercase tracking-[0.2em] text-slate-400">Proof points</p>
        <h2 class="mt-3 text-3xl font-black tracking-tight">Why teams can trust the workflow.</h2>
      </div>
      <div class="mt-8 grid gap-4 md:grid-cols-3">
        <% [
          ['Every value is reviewable', 'AI values and officer corrections are stored separately.'],
          ['Evidence stays attached', 'Findings link back to uploaded package images and OCR text.'],
          ['Reports are audit-ready', 'Inspections, checks, violations and logs are saved to the database.']
        ].forEach(item => { %>
          <div class="rounded-3xl border soft-border bg-white p-6 shadow-sm shadow-blue-950/5">
            <p class="text-lg font-black text-ink"><%= item[0] %></p>
            <p class="mt-3 text-sm leading-6 text-slate-600"><%= item[1] %></p>
          </div>
        <% }) %>
      </div>
    </section>

    <section id="portals" class="mx-auto max-w-7xl px-5 py-20 sm:px-8">
      <div class="grid items-start gap-8 md:grid-cols-[.8fr_1.2fr]">
        <div>
          <p class="text-[11px] font-black uppercase tracking-[0.2em] text-[#2563eb]">Get started</p>
          <h2 class="mt-3 text-4xl font-black tracking-tight">Choose the right door.</h2>
          <p class="mt-4 text-sm leading-7 text-slate-600">Consumers scan, businesses pre-check, and officers verify inspection records.</p>
        </div>
        <div class="grid gap-4">
          <% [
            ['/public/login', 'Consumer Portal', 'Scan products and submit suspected packaging issues.'],
            ['/business/login', 'Business Portal', 'Check artwork and labels before market release.'],
            ['/officer/login', 'Officer Portal', 'Inspect, verify evidence and finalize reports.']
          ].forEach(portal => { %>
            <a href="<%= portal[0] %>" class="group flex items-center justify-between rounded-3xl border soft-border bg-white p-6 shadow-sm shadow-blue-950/5 transition hover:-translate-y-1 hover:shadow-xl hover:shadow-blue-950/10">
              <div>
                <h3 class="text-lg font-black text-ink"><%= portal[1] %></h3>
                <p class="mt-2 text-sm text-slate-600"><%= portal[2] %></p>
              </div>
              <span class="grid h-11 w-11 place-items-center rounded-full bg-[#dbeafe] font-black transition group-hover:bg-[#2563eb] group-hover:text-white">→</span>
            </a>
          <% }) %>
        </div>
      </div>
    </section>

    <section id="faq" class="mx-auto max-w-7xl px-5 pb-20 sm:px-8">
      <div class="rounded-[28px] border soft-border bg-white p-6 shadow-sm shadow-blue-950/5 md:p-10">
        <div class="text-center">
          <p class="text-[11px] font-black uppercase tracking-[0.2em] text-slate-400">Answers</p>
          <h2 class="mt-3 text-3xl font-black tracking-tight">Frequently asked questions</h2>
        </div>
        <div class="mt-8 grid gap-4 md:grid-cols-2">
          <% [
            ['Does AI decide legality?', 'No. AI extracts declarations. Deterministic checks and officer verification handle compliance decisions.'],
            ['Can it scan multiple images?', 'Yes. Front, back and close-up photos are combined into one product inspection.'],
            ['Where is evidence stored?', 'OCR results, findings and verification decisions are saved with the inspection record.'],
            ['Can the public use it?', 'Yes. The public portal supports demo access and product photo scanning.']
          ].forEach(faq => { %>
            <div class="rounded-2xl border soft-border bg-[#f8fbff] p-5">
              <h3 class="font-black text-ink"><%= faq[0] %></h3>
              <p class="mt-2 text-sm leading-6 text-slate-600"><%= faq[1] %></p>
            </div>
          <% }) %>
        </div>
      </div>
    </section>
  </main>

  <footer id="contact" class="mx-auto max-w-[1500px] px-3 pb-3">
    <div class="rounded-[28px] bg-gradient-to-br from-[#0f3564] to-[#101828] px-5 py-8 text-white sm:px-10">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <p class="text-lg font-black">PackCheck AI</p>
        <p class="text-sm text-slate-300">AI-powered packaged commodity compliance checker for SIH 2026.</p>
      </div>
    </div>
  </footer>
</body>
</html>
