<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sign Up - LabelIQ</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['Inter', 'sans-serif'] }
        }
      }
    }
  </script>
</head>
<body class="bg-[#FAFBFD] font-sans text-slate-800 min-h-screen flex items-center justify-center px-4 py-6 sm:p-6 antialiased overflow-x-hidden">

  <div class="w-full max-w-md bg-white rounded-3xl shadow-xl shadow-slate-200/50 border border-slate-100 p-5 sm:p-10 space-y-5 sm:space-y-6">
    
    <!-- Header -->
    <div class="flex flex-col items-center text-center space-y-2">
      <div class="flex justify-center">
        <img src="/assets/labeliq-logo.png" alt="LabelIQ" class="h-14 w-auto object-contain" />
      </div>
      <h1 class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight">Create Account</h1>
      <p class="text-sm text-slate-500">
        Registering for: <strong class="text-[#4338CA] uppercase"><%= portal %> Portal</strong>
      </p>
    </div>

    <!-- Portal Switcher Tabs -->
    <div class="grid grid-cols-3 rounded-xl bg-slate-100 p-1 text-xs font-semibold text-slate-600">
      <a href="/signup?portal=consumer" class="flex-1 py-2 text-center rounded-lg <%= portal === 'consumer' ? 'bg-white text-slate-900 shadow-sm' : 'hover:text-slate-900' %>">Consumer</a>
      <a href="/signup?portal=business" class="flex-1 py-2 text-center rounded-lg <%= portal === 'business' ? 'bg-white text-slate-900 shadow-sm' : 'hover:text-slate-900' %>">Business</a>
      <a href="/signup?portal=legal" class="flex-1 py-2 text-center rounded-lg <%= portal === 'legal' ? 'bg-white text-slate-900 shadow-sm' : 'hover:text-slate-900' %>">Legal</a>
    </div>

    <!-- Google Sign Up Button -->
    <% if (['consumer', 'business', 'legal'].includes(portal)) { %>
      <div class="space-y-4">
        <%- include('partials/google-oauth') %>

        <div class="flex items-center gap-3">
          <div class="h-px flex-1 bg-slate-200"></div>
          <span class="shrink-0 text-[10px] sm:text-xs uppercase text-slate-400 font-semibold tracking-wider">or sign up with email</span>
          <div class="h-px flex-1 bg-slate-200"></div>
        </div>
      </div>
    <% } %>

    <!-- Error Alert -->
    <% if (error) { %>
      <div class="p-3 rounded-xl bg-red-50 border border-red-100 text-xs text-red-600 font-medium text-center">
        <%= error %>
      </div>
    <% } %>

    <!-- Email Sign Up Form -->
    <form action="/signup" method="POST" class="space-y-4">
      <input type="hidden" name="portal" value="<%= portal %>" />

      <div>
        <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Username</label>
        <input 
          type="text" 
          name="username" 
          required 
          placeholder="Choose a username"
          class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:border-[#4338CA] focus:ring-2 focus:ring-indigo-100 transition-all placeholder:text-slate-400"
        />
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Password</label>
        <input 
          type="password" 
          name="password" 
          required 
          placeholder="Create password"
          class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:border-[#4338CA] focus:ring-2 focus:ring-indigo-100 transition-all placeholder:text-slate-400"
        />
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Confirm Password</label>
        <input 
          type="password" 
          name="confirmPassword" 
          required 
          placeholder="Confirm password"
          class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:border-[#4338CA] focus:ring-2 focus:ring-indigo-100 transition-all placeholder:text-slate-400"
        />
      </div>

      <button 
        type="submit" 
        class="w-full py-3 rounded-xl bg-[#4338CA] hover:bg-[#3730A3] text-white font-semibold text-sm shadow-md shadow-indigo-600/20 transition-all mt-2"
      >
        Register Account
      </button>
    </form>

    <!-- Sign In Redirect -->
    <div class="text-center pt-2 border-t border-slate-100">
      <p class="text-xs text-slate-500">
        Already have an account? 
        <a href="/signin?portal=<%= portal %>" class="font-semibold text-[#4338CA] hover:underline">Sign In</a>
      </p>
    </div>

  </div>

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script>
    window.LABELIQ_SUPABASE_URL = <%- JSON.stringify(supabase.url || '') %>;
    window.LABELIQ_SUPABASE_PUBLISHABLE_KEY = <%- JSON.stringify(supabase.publishableKey || '') %>;
  </script>
  <script src="/js/supabase-oauth.js"></script>
</body>
</html>
