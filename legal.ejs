<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>LabelIQ - Enforcement Case Queue</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['Inter', 'sans-serif'] },
          colors: {
            brand: {
              DEFAULT: '#4638d9',
              hover: '#3a2ec2'
            }
          }
        }
      }
    }
  </script>
</head>
<body class="bg-[#fcfdff] text-slate-700 antialiased font-sans min-h-screen flex flex-col">

  <!-- Top Navbar -->
  <header class="w-full bg-white border-b border-slate-100 sticky top-0 z-50">
    <div class="px-8 h-16 flex items-center justify-between">
      
      <!-- Brand & Links -->
      <div class="flex items-center gap-10">
        <a href="/" class="flex items-center gap-2.5">
          <div class="w-7 h-7 rounded-lg bg-[#4638d9] flex items-center justify-center text-white">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
              <line x1="4" y1="6" x2="6" y2="6" />
              <line x1="10" y1="6" x2="20" y2="6" />
              <line x1="4" y1="12" x2="6" y2="12" />
              <line x1="10" y1="12" x2="20" y2="12" />
              <line x1="4" y1="18" x2="6" y2="18" />
              <line x1="10" y1="18" x2="20" y2="18" />
            </svg>
          </div>
          <span class="text-xl font-bold text-slate-900 tracking-tight">LabelIQ</span>
        </a>

        <nav class="hidden md:flex items-center gap-8 text-[14px] font-medium text-slate-600">
          <a href="#" class="hover:text-slate-900 transition-colors">Product</a>
          <a href="#" class="hover:text-slate-900 transition-colors">Rule Engine</a>
          <a href="#" class="hover:text-slate-900 transition-colors">Verification</a>
        </nav>
      </div>

      <!-- Right Portal Menu with Dropdown -->
      <div class="flex items-center gap-6">
        <div class="relative" id="portal-menu-container">
          <button 
            id="portal-btn"
            type="button"
            class="flex items-center gap-1.5 text-[14px] font-medium text-slate-800 hover:text-slate-900 focus:outline-none"
          >
            <span>Legal Authority</span>
            <svg id="dropdown-chevron" class="w-4 h-4 text-slate-400 stroke-[2] transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </button>

          <!-- Dropdown Navigation -->
          <div 
            id="portal-dropdown" 
            class="hidden absolute right-0 top-full mt-2 w-56 bg-white rounded-2xl shadow-xl shadow-slate-200/60 border border-slate-100 overflow-hidden z-50 py-1"
          >
            <a href="/" class="w-full px-5 py-3 text-left text-[14px] font-medium text-slate-800 hover:bg-slate-50 transition-colors block">
              Consumer Portal
            </a>
            <a href="/business" class="w-full px-5 py-3 text-left text-[14px] font-medium text-slate-800 hover:bg-slate-50 transition-colors block">
              Business Portal
            </a>
            <a href="/legal" class="w-full px-5 py-3 text-left text-[14px] font-medium text-[#4638d9] bg-[#f5f6ff] hover:bg-[#eceeff] flex items-center justify-between transition-colors block">
              <span>Legal Authority</span>
              <svg class="w-3.5 h-3.5 text-[#4638d9] stroke-[2.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </a>
          </div>
        </div>

        <a href="/signin" class="px-5 py-2 rounded-lg bg-[#4638d9] hover:bg-[#3a2ec2] text-white font-medium text-[14px] shadow-sm transition-colors">
          Sign Out
        </a>
      </div>
    </div>
  </header>

  <div class="flex flex-1">
    
    <!-- Sidebar -->
    <aside class="w-64 border-r border-slate-100 bg-white flex flex-col justify-between py-6 px-4 shrink-0">
      <div class="space-y-6">
        
        <!-- Officer Info Card -->
        <div class="flex items-center justify-between px-2">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-[#fbf2ea] text-[#d97706] font-bold text-xs flex items-center justify-center border border-[#fed7aa]/50">
              <%= data.officer.initials %>
            </div>
            <div>
              <h2 class="text-sm font-bold text-slate-900 leading-tight"><%= data.officer.name %></h2>
              <p class="text-xs text-slate-400 mt-0.5"><%= data.officer.role %></p>
            </div>
          </div>
          <button class="text-slate-400 hover:text-slate-600">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
            </svg>
          </button>
        </div>

        <!-- Audit Alert Pill -->
        <div class="mx-1 px-3 py-2 rounded-xl bg-[#fffbeb] border border-[#fef3c7] flex items-center gap-2 text-xs text-[#b45309] font-medium">
          <svg class="w-4 h-4 text-[#d97706] shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
          </svg>
          <span>All actions are audit-logged</span>
        </div>

        <!-- Sidebar Navigation -->
        <nav class="space-y-1 pt-2">
          <a href="#" class="flex items-center justify-between px-3.5 py-2.5 rounded-xl bg-[#f5f6ff] text-[#4638d9] font-semibold text-[14px]">
            <span>Submitted Complaints</span>
          </a>

          <a href="#" class="flex items-center justify-between px-3.5 py-2.5 rounded-xl text-slate-600 hover:bg-slate-50 font-medium text-[14px] transition-colors">
            <span>Case Queue</span>
            <span class="w-5 h-5 rounded-full bg-[#ef4444] text-white text-[11px] font-bold flex items-center justify-center">1</span>
          </a>

          <a href="#" class="flex items-center px-3.5 py-2.5 rounded-xl text-slate-600 hover:bg-slate-50 font-medium text-[14px] transition-colors">
            Inspection Records
          </a>

          <a href="#" class="flex items-center px-3.5 py-2.5 rounded-xl text-slate-600 hover:bg-slate-50 font-medium text-[14px] transition-colors">
            Rule Management
          </a>

          <a href="#" class="flex items-center px-3.5 py-2.5 rounded-xl text-slate-600 hover:bg-slate-50 font-medium text-[14px] transition-colors">
            Audit Trail
          </a>
        </nav>
      </div>
    </aside>

    <!-- Main Workspace -->
    <main class="flex-1 px-10 py-8 overflow-y-auto max-w-5xl">
      
      <!-- Page Title -->
      <div>
        <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Enforcement Case Queue</h1>
        <p class="text-sm text-slate-500 mt-1"><%= data.officer.region %></p>
      </div>

      <!-- Filter Pills -->
      <div class="mt-6 flex flex-wrap items-center gap-2">
        <% data.filters.forEach(filter => { %>
          <% if (filter.active) { %>
            <button class="px-5 py-1.5 rounded-full border border-[#4638d9] text-[#4638d9] text-xs font-semibold bg-indigo-50/20">
              <%= filter.label %>
            </button>
          <% } else { %>
            <button class="px-5 py-1.5 rounded-full border border-slate-200 text-slate-600 text-xs font-medium hover:border-slate-300 bg-white transition-colors">
              <%= filter.label %>
            </button>
          <% } %>
        <% }) %>
      </div>

      <!-- Metric Cards Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mt-6">
        <div class="bg-white border border-slate-200/80 rounded-2xl p-5 shadow-xs">
          <p class="text-3xl font-bold text-slate-900"><%= data.metrics.totalCases %></p>
          <p class="text-xs text-slate-400 mt-1.5">Total cases</p>
        </div>

        <div class="bg-white border border-slate-200/80 rounded-2xl p-5 shadow-xs">
          <p class="text-3xl font-bold text-slate-900"><%= data.metrics.awaitingAction %></p>
          <p class="text-xs text-slate-400 mt-1.5">Awaiting action</p>
        </div>

        <div class="bg-white border border-slate-200/80 rounded-2xl p-5 shadow-xs">
          <p class="text-3xl font-bold text-slate-900"><%= data.metrics.investigating %></p>
          <p class="text-xs text-slate-400 mt-1.5">Investigating</p>
        </div>

        <div class="bg-white border border-slate-200/80 rounded-2xl p-5 shadow-xs">
          <p class="text-3xl font-bold text-slate-900"><%= data.metrics.verifiedViolations %></p>
          <p class="text-xs text-slate-400 mt-1.5">Verified violations</p>
        </div>
      </div>

      <!-- Case Cards Queue -->
      <div class="mt-8 space-y-3.5">
        <% data.cases.forEach(item => { %>
          <div class="bg-white border border-slate-200/80 rounded-2xl p-5 hover:border-slate-300 transition-all cursor-pointer flex items-center justify-between group shadow-xs">
            <div class="space-y-2">
              
              <!-- ID, Status, and Date -->
              <div class="flex items-center gap-2.5">
                <span class="w-2 h-2 rounded-full <%= item.dotColor %> shrink-0"></span>
                <span class="text-xs font-mono text-slate-400"><%= item.id %></span>
                <span class="px-2.5 py-0.5 rounded-full text-[11px] font-semibold <%= item.statusStyle %>">
                  <%= item.status %>
                </span>
                <span class="text-xs text-slate-400"><%= item.date %></span>
              </div>

              <!-- Product Title -->
              <h3 class="text-[15px] font-bold text-slate-900 tracking-tight">
                <%= item.title %>
              </h3>

              <!-- Source / Reporter -->
              <p class="text-xs text-slate-500 font-normal">
                <%= item.source %>
              </p>

              <!-- Rules Tags -->
              <div class="flex items-center gap-2 pt-1">
                <% item.rules.forEach(rule => { %>
                  <span class="px-2 py-0.5 rounded-md bg-[#fff1f2] border border-[#ffe4e6] text-[#e11d48] text-[11px] font-mono font-medium">
                    <%= rule %>
                  </span>
                <% }) %>
              </div>

            </div>

            <!-- Right Chevron -->
            <div class="text-slate-300 group-hover:text-slate-500 group-hover:translate-x-0.5 transition-all pr-1">
              <svg class="w-5 h-5 stroke-[2]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </div>
          </div>
        <% }) %>
      </div>

    </main>
  </div>

  <!-- Help Floating Action Button -->
  <button 
    aria-label="Help" 
    class="fixed bottom-6 right-6 w-10 h-10 rounded-full bg-[#181d27] text-white flex items-center justify-center font-bold text-sm shadow-md hover:bg-black transition-colors"
  >
    ?
  </button>

  <script>
    const portalBtn = document.getElementById('portal-btn');
    const portalDropdown = document.getElementById('portal-dropdown');
    const dropdownChevron = document.getElementById('dropdown-chevron');

    portalBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      portalDropdown.classList.toggle('hidden');
      dropdownChevron.classList.toggle('rotate-180');
    });

    document.addEventListener('click', (e) => {
      const container = document.getElementById('portal-menu-container');
      if (container && !container.contains(e.target)) {
        portalDropdown.classList.add('hidden');
        dropdownChevron.classList.remove('rotate-180');
      }
    });
  </script>
</body>
</html>